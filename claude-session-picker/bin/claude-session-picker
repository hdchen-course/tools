#!/usr/bin/env bash
# =============================================================================
# claude-session-picker — a menu for resuming your Claude Code sessions.
#
# WHAT IT DOES (plain language):
#   Claude Code saves every conversation you have. Over time you build up dozens
#   of them across different projects, and the only way back into one is to
#   remember its id. This tool shows all your sessions in a simple keyboard menu
#   — newest first, with a title, which project it belongs to, and how long ago
#   it was active — and lets you jump straight back into any one. A "●" marks
#   sessions that have a live Claude running right now.
#
#   It replaces the habit of keeping a dozen terminal tabs open "so you don't
#   lose" a session: everything is one keypress away from one window.
#
# WHY IT NEEDS NOTHING INSTALLED:
#   It reads Claude's own files under ~/.claude and resumes with the `claude`
#   command you already have. No tmux, no fzf, no Homebrew. It runs on a bare
#   remote Linux host exactly as it does on a Mac.
#
# HOW IT STAYS SAFE:
#   - All decision logic lives in lib/core.sh as pure, unit-tested functions.
#   - All disk/process access lives in lib/sessions.sh.
#   - This file only wires input → logic → drawing. It sets strict shell flags,
#     bounds every loop, and restores the terminal on ANY exit path so a crash
#     can never leave your terminal in a broken state.
# =============================================================================

set -u  # Treat use of an unset variable as an error — catches typos early.
# NOTE: we intentionally do NOT use `set -e` here. This is an interactive loop,
# and many commands (a `read` that times out, a `grep` that finds nothing) exit
# non-zero as normal control flow; `set -e` would abort the whole picker on
# those and could leave the terminal half-restored. We handle errors explicitly
# instead. Please don't add `set -e`.

# --- Locate our own library files, following symlinks -----------------------
# The installer symlinks this script into a bin dir, so we resolve the real
# location to find lib/ next to it. We start from ${BASH_SOURCE[0]} rather than
# $0 because it names THIS file both when the script is run normally and when a
# test sources it (where $0 would instead be the shell/bats runner).
csp_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$csp_self" ]; do
  csp_link_target=$(readlink "$csp_self")
  case "$csp_link_target" in
    /*) csp_self="$csp_link_target" ;;                        # absolute link
    *)  csp_self="$(dirname "$csp_self")/$csp_link_target" ;; # relative link
  esac
done
CSP_ROOT="$(cd "$(dirname "$csp_self")/.." && pwd)"

# shellcheck source=../lib/core.sh
. "$CSP_ROOT/lib/core.sh"
# shellcheck source=../lib/sessions.sh
. "$CSP_ROOT/lib/sessions.sh"
# shellcheck source=../lib/backend.sh
. "$CSP_ROOT/lib/backend.sh"

# Which backend runs sessions (see csp_choose_backend / lib/backend.sh). The
# CSP_BACKEND environment variable forces "hub" or "tmux" (case-sensitive);
# empty means auto. If it's set to something unrecognised, warn instead of
# silently falling back to auto (which would look like the flag was ignored).
if ! csp_backend_is_valid "${CSP_BACKEND:-}"; then
  printf 'Warning: CSP_BACKEND="%s" is not recognised (use "hub" or "tmux"); using auto-detect.\n' \
    "${CSP_BACKEND}" >&2
fi
CSP_ACTIVE_BACKEND=$(csp_choose_backend \
  "$(csp_tmux_available && echo 1 || echo 0)" \
  "$(csp_inside_tmux && echo 1 || echo 0)" \
  "${CSP_BACKEND:-}")

# --- Colours & box-drawing ---------------------------------------------------
# The menu is drawn as a framed "GUI-style" panel. All the escape codes live
# here so the look is defined in one place. Colour is turned OFF automatically
# when output is not a terminal, or when the user sets NO_COLOR (a widely
# respected convention) or CSP_NO_COLOR — so the tool stays readable and its
# output stays clean everywhere.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -z "${CSP_NO_COLOR:-}" ]; then
  CSP_C_RESET=$'\033[0m'
  CSP_C_FRAME=$'\033[38;5;244m'   # dim grey for the box border
  CSP_C_TITLE=$'\033[1;38;5;39m'  # bold blue for the app title
  CSP_C_HEADER=$'\033[38;5;250m'  # column headings
  CSP_C_SEL=$'\033[7m'            # reverse video for the selected row
  CSP_C_LIVE=$'\033[38;5;42m'     # green for the ● running marker
  CSP_C_DIM=$'\033[38;5;244m'     # dim for ages / hints
  CSP_C_KEY=$'\033[1;38;5;250m'   # bold for key names in the status bar
else
  CSP_C_RESET=""; CSP_C_FRAME=""; CSP_C_TITLE=""; CSP_C_HEADER=""
  CSP_C_SEL=""; CSP_C_LIVE=""; CSP_C_DIM=""; CSP_C_KEY=""
fi

# Box-drawing characters (Unicode). These render the frame.
CSP_BX_TL="┌"; CSP_BX_TR="┐"; CSP_BX_BL="└"; CSP_BX_BR="┘"
CSP_BX_H="─";  CSP_BX_V="│";  CSP_BX_ML="├"; CSP_BX_MR="┤"

# --- Terminal handling -------------------------------------------------------
# We switch the terminal into "raw-ish" mode to read single keypresses, and we
# ALWAYS put it back. The trap guarantees restoration even if we crash or are
# killed — this is the core of "never leave the terminal broken". The trap is
# installed BEFORE we ever change terminal modes, so there is no window in which
# a failure could skip the cleanup.
# csp_saved_stty holds the PRISTINE terminal settings, captured exactly ONCE
# before we ever touch the terminal (see csp_capture_pristine_stty). We must
# never re-capture after that: if we did, and a crashed Claude left the terminal
# in a broken mode, we would "restore" that broken mode. Capturing once means we
# always put the terminal back the way the user's shell handed it to us.
csp_saved_stty=""
csp_stty_captured=0

csp_capture_pristine_stty() {
  # Capture only the first time; later calls are deliberate no-ops.
  [ "$csp_stty_captured" = "1" ] && return 0
  csp_saved_stty=$(stty -g 2>/dev/null) || csp_saved_stty=""
  csp_stty_captured=1
}

# csp_restore_terminal — put the terminal fully back to normal. It is safe to
# call more than once and on any exit path. It undoes everything a raw-mode TUI
# (ours or a crashed Claude we returned from) could have left on:
#   • show the cursor again
#   • leave the alternate screen buffer, and turn mouse reporting off — a
#     crashed Claude often leaves these on, which otherwise spews escape
#     garbage or hides the shell prompt
#   • restore the exact saved settings; if we never captured any (or capture
#     failed), fall back to `stty sane`, a known-good cooked mode, so the user
#     is never left with no echo / no Ctrl-C.
csp_restore_terminal() {
  printf '\033[?25h\033[?1049l\033[?1000l\033[?1006l' 2>/dev/null
  if [ -n "$csp_saved_stty" ]; then
    stty "$csp_saved_stty" 2>/dev/null || stty sane 2>/dev/null
  else
    stty sane 2>/dev/null
  fi
}

# Interrupt handling has ONE designed outcome: restore the terminal and exit.
# Falling back into the raw-mode loop after an interrupt (the previous bug)
# could leave the terminal cooked while the menu kept running, or even open a
# session on an empty keypress. We give INT/TERM/QUIT/HUP/PIPE a single clean
# destination. Not installed when a test merely sources this file.
csp_on_signal() {
  csp_restore_terminal
  exit 130
}
if [ -z "${CSP_SOURCED_FOR_TEST:-}" ]; then
  trap 'csp_restore_terminal' EXIT
  trap 'csp_on_signal' INT TERM QUIT HUP PIPE
fi

csp_enter_raw_mode() {
  csp_capture_pristine_stty           # captures once; safe to call repeatedly
  stty -echo -icanon min 1 time 0 2>/dev/null
  printf '\033[?25l'                 # hide the cursor while the menu is drawn
}

# csp_read_key — read one keypress and return a single normalised token:
#   j / k        down / up      (from 'j','k' or the ↓/↑ arrows)
#   g / G        first / last
#   n            new session
#   R / l        reload
#   q            quit           (also a bare Esc)
#   _            "ignore me"    (any other arrow / escape sequence)
#   <char>       any other single character, passed through unchanged
#
# The tricky part is escape sequences. An arrow key sends three-plus bytes
# (ESC [ A). Home/End/PageUp send ESC [ 1 ~ etc., and a stray mouse click from a
# terminal left in mouse-reporting mode sends ESC [ M followed by raw bytes.
# The previous version read a FIXED two bytes after ESC, which left the tail of
# longer sequences (the '~', the mouse coordinates) sitting in the input to be
# misread as if the user had typed them — a stray click could even quit the
# picker. We instead CONSUME THE WHOLE sequence: after ESC-[ we read bytes until
# the terminating "final byte" (in the 0x40–0x7E range), so nothing is left
# behind. Only a bare Esc — an ESC with nothing following — quits.
csp_read_key() {
  local k rest c
  IFS= read -r -n 1 k 2>/dev/null || { printf 'q'; return; }

  if [ "$k" != $'\033' ]; then
    printf '%s' "$k"
    return
  fi

  # We saw ESC. Read the next byte (short timeout) to see if a sequence follows.
  IFS= read -r -n 1 -t 1 rest 2>/dev/null
  if [ -z "$rest" ]; then
    printf 'q'                     # bare Esc → quit
    return
  fi
  if [ "$rest" != '[' ] && [ "$rest" != 'O' ]; then
    printf '_'                     # ESC + something we don't handle → ignore
    return
  fi

  # It's a CSI/SS3 sequence. Read the (up to few) parameter/final bytes, mapping
  # the arrows and discarding everything else. Loop until a final byte or EOF.
  IFS= read -r -n 1 -t 1 c 2>/dev/null
  case "$c" in
    'A') printf 'k'; return ;;     # up
    'B') printf 'j'; return ;;     # down
    'C'|'D') printf '_'; return ;; # right/left → no-op
  esac
  # Longer sequence (e.g. Home = ESC [ 1 ~, or a mouse report): drain to its end
  # so no leftover bytes are read as keystrokes, then report "ignore".
  while [ -n "$c" ]; do
    case "$c" in
      [A-Za-z~]) break ;;          # a final byte — sequence complete
    esac
    IFS= read -r -n 1 -t 1 c 2>/dev/null
  done
  printf '_'
}

# --- In-memory session model -------------------------------------------------
# We keep parallel indexed arrays (bash 3.2 has no associative arrays). Every
# access is guarded by csp_clamp_index so an out-of-range read is impossible.
csp_ids=()
csp_titles=()
csp_projects=()
csp_fullprojects=()   # full cwd path, kept for the resume `cd`
csp_files=()          # on-disk .jsonl path, kept for delete
csp_ages=()
csp_lives=()
csp_count=0

# csp_load_sessions — build the model from Claude's session store. Enforces the
# CSP_MAX_SESSIONS cap (via csp_list_session_files) so memory stays bounded.
csp_load_sessions() {
  local file id meta title fullcwd project mtime now running is_live
  csp_ids=(); csp_titles=(); csp_projects=(); csp_fullprojects=()
  csp_ages=(); csp_lives=(); csp_files=()
  csp_count=0
  now=$(csp_now_epoch)
  running=$(csp_running_session_ids)

  while IFS= read -r file; do
    [ -z "$file" ] && continue
    id=$(csp_session_id_from_path "$file")
    # One read per file for both title and cwd (see csp_session_meta).
    meta=$(csp_session_meta "$file")
    title=$(csp_truncate "$(csp_field "$meta" 1)" "$CSP_MAX_TITLE_LEN")
    fullcwd=$(csp_field "$meta" 2)
    project=$(csp_short_path "$fullcwd")
    mtime=$(csp_file_mtime "$file")
    is_live=0
    csp_is_live "$id" "$running" && is_live=1

    csp_ids[$csp_count]="$id"
    csp_titles[$csp_count]="$title"
    csp_projects[$csp_count]="$project"
    csp_ages[$csp_count]="$(csp_humanize_age "$((now - mtime))")"
    csp_lives[$csp_count]="$is_live"
    # Remember the full project path alongside the id, for the resume `cd`.
    csp_fullprojects[$csp_count]="$fullcwd"
    # Remember the on-disk file so we can delete the session if asked.
    csp_files[$csp_count]="$file"
    csp_count=$((csp_count + 1))
  done <<EOF
$(csp_list_session_files)
EOF
}

# csp_visible_rows — how many session rows fit on the current terminal, leaving
# room for the two header lines and a footer.
#
# We read the height from `stty size` FIRST, because it reports the real
# current size of the terminal device. `tput lines` is only a fallback: it can
# return a stale terminfo default (e.g. 24) inside a resized window, which would
# make us draw more rows than fit and push the header off-screen. If neither
# works (e.g. output isn't a terminal at all), we assume a conservative 24.
csp_visible_rows() {
  local rows=""
  # `stty size` prints "ROWS COLS"; take the first number.
  rows=$(stty size 2>/dev/null | { read -r r _ 2>/dev/null; printf '%s' "$r"; })
  case "$rows" in ''|*[!0-9]*) rows=$(tput lines 2>/dev/null) ;; esac
  case "$rows" in ''|*[!0-9]*) rows=24 ;; esac
  # Reserve the frame chrome: top border, subtitle, divider, column header,
  # divider, status bar, bottom border = 7 lines (8 for a little slack).
  rows=$((rows - 8))
  [ "$rows" -lt 1 ] && rows=1
  printf '%d' "$rows"
}

# csp_term_cols — the terminal width in columns (stty first, then tput, then 80).
csp_term_cols() {
  local cols=""
  cols=$(stty size 2>/dev/null | { read -r _ c 2>/dev/null; printf '%s' "$c"; })
  case "$cols" in ''|*[!0-9]*) cols=$(tput cols 2>/dev/null) ;; esac
  case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
  printf '%d' "$cols"
}

# csp_repeat STR N — print STR repeated N times (used to draw border rules).
csp_repeat() {
  local str="$1" n="$2" out=""
  while [ "$n" -gt 0 ]; do out="$out$str"; n=$(( n - 1 )); done
  printf '%s' "$out"
}

# The inner content width of the framed panel (columns between the │ borders,
# excluding the one space of padding on each side). Set once per draw.
CSP_INNER=82

# csp_frame_top / _mid / _bot [TITLE]
# Print a horizontal frame rule. The top rule embeds the app title.
csp_frame_top() {
  local title="$1" tw fill
  tw=$(csp_display_width "$title")
  # Layout: ┌─ <title> <fill dashes>┐   with the +2 accounting for the two
  # spaces around the title, matching the " content " padding of the rows.
  fill=$(( CSP_INNER + 2 - tw - 3 ))
  [ "$fill" -lt 0 ] && fill=0
  printf '%s%s%s %s %s%s%s\n' \
    "$CSP_C_FRAME" "$CSP_BX_TL" "$CSP_BX_H" \
    "${CSP_C_TITLE}${title}${CSP_C_RESET}${CSP_C_FRAME}" \
    "$(csp_repeat "$CSP_BX_H" "$fill")" "$CSP_BX_TR" "$CSP_C_RESET"
}
csp_frame_mid() {
  printf '%s%s%s%s%s%s\n' "$CSP_C_FRAME" "$CSP_BX_ML" \
    "$(csp_repeat "$CSP_BX_H" "$(( CSP_INNER + 2 ))")" "$CSP_BX_MR" "" "$CSP_C_RESET"
}
csp_frame_bot() {
  printf '%s%s%s%s%s\n' "$CSP_C_FRAME" "$CSP_BX_BL" \
    "$(csp_repeat "$CSP_BX_H" "$(( CSP_INNER + 2 ))")" "$CSP_BX_BR" "$CSP_C_RESET"
}

# csp_frame_row CONTENT [SELECTED]
# Print one content line inside the frame: "│ <content padded to CSP_INNER> │".
#
# IMPORTANT: CONTENT must be PLAIN text (no colour escapes), because we measure
# its display width to pad the row to the exact inner width. We only add colour
# AFTER padding — otherwise the invisible escape bytes would be counted as width
# and the row would be truncated too early / the right border would misalign.
#   • selected row → reverse video across the whole width (a solid highlight)
#   • otherwise    → tint any green-able ● marker after padding (width is fixed
#     by then, so recolouring a single glyph can't shift the layout)
# Optional 3rd arg STYLE: a colour escape applied to the whole (plain) content
# after padding — used for the dimmed mode line and column header. Passing plain
# text + a style keeps width measurement correct (see the note above).
csp_frame_row() {
  local content="$1" selected="${2:-0}" style="${3:-}" fitted padded
  fitted=$(csp_truncate_display "$content" "$CSP_INNER")
  padded=$(csp_pad_display "$fitted" "$CSP_INNER")
  # One format string used by every branch: left border, a space, the (already
  # coloured) body, a space, right border, reset. Exactly 6 %s for 6 arguments —
  # keeping these in lock-step matters: a spare argument makes printf reuse the
  # format and emit a stray blank line after each row.
  local body
  if [ "$selected" = "1" ]; then
    body="${CSP_C_SEL}${padded}${CSP_C_RESET}"
  elif [ -n "$style" ]; then
    body="${style}${padded}${CSP_C_RESET}"
  else
    # Recolour the live marker green (safe: width already fixed by padding).
    [ -n "$CSP_C_LIVE" ] && padded="${padded/$CSP_MARKER_LIVE/${CSP_C_LIVE}${CSP_MARKER_LIVE}${CSP_C_RESET}}"
    body="$padded"
  fi
  printf '%s%s %s %s%s%s\n' \
    "$CSP_C_FRAME" "$CSP_BX_V" "$body" "$CSP_C_FRAME" "$CSP_BX_V" "$CSP_C_RESET"
}

# csp_draw SELECTED — render the framed menu for the given cursor position,
# showing only the rows that fit and keeping the selection in view (see
# csp_window_start). Draws a GUI-style panel: title bar, mode line, column
# headings, the session rows (selected one highlighted), and a status bar.
csp_draw() {
  local selected="$1" i marker live_row row is_sel visible start last
  local mode_line header cols

  # Fit the panel to the terminal (with sane min/max), once per frame.
  cols=$(csp_term_cols)
  CSP_INNER=$(( cols - 4 ))
  [ "$CSP_INNER" -gt 92 ] && CSP_INNER=92
  [ "$CSP_INNER" -lt 40 ] && CSP_INNER=40

  printf '\033[2J\033[H'   # clear screen, move cursor home

  csp_frame_top "Claude Session Picker"

  # Mode line: says whether quitting a session returns you here (hub) or leaves
  # others running (tmux), and — in hub with tmux present — how to get concurrency.
  if [ "$CSP_ACTIVE_BACKEND" = "tmux" ]; then
    mode_line="mode: tmux · each session in its own window, others keep running"
  else
    mode_line="mode: hub · quit a session to come back to this menu"
    csp_tmux_available && mode_line="$mode_line  (CSP_BACKEND=tmux for concurrency)"
  fi
  csp_frame_row "$mode_line" 0 "$CSP_C_DIM"
  csp_frame_mid

  if [ "$csp_count" -eq 0 ]; then
    csp_frame_row "No Claude sessions found under $CSP_CLAUDE_DIR/projects"
    csp_frame_row "Start one with:  claude    then reopen this picker."
    csp_frame_bot
    return
  fi

  # Column headings (● legend + Title / Project / Last active), dimmed.
  header=$(csp_format_line "●" "Title" "Project" "Last active" 0)
  csp_frame_row "$header" 0 "$CSP_C_HEADER"

  visible=$(csp_visible_rows)
  start=$(csp_window_start "$selected" "$csp_count" "$visible")
  last=$((start + visible))
  [ "$last" -gt "$csp_count" ] && last="$csp_count"

  i="$start"
  while [ "$i" -lt "$last" ]; do
    marker=$(csp_marker_for_session "${csp_lives[$i]}")
    row=$(csp_format_line "$marker" "${csp_titles[$i]}" "${csp_projects[$i]}" \
      "${csp_ages[$i]}" "$([ "$i" -eq "$selected" ] && echo 1 || echo 0)")
    is_sel=0; [ "$i" -eq "$selected" ] && is_sel=1
    # csp_frame_row tints the live ● green itself (after padding), so we pass the
    # plain row and let it handle colour without disturbing the width.
    csp_frame_row "$row" "$is_sel"
    i=$((i + 1))
  done

  csp_frame_mid
  # Status bar: key hints on the left, position (n/total) on the right. We use
  # plain ASCII key names (j/k, Enter) so their width is unambiguous across
  # terminals, and colour just the key letters. Spacing is computed from the
  # PLAIN text widths so the colour escapes never skew the alignment.
  local keys_plain pos_plain keys pos gap
  keys_plain="j/k move   Enter open   n new   d del   R reload   q quit"
  pos_plain="$((selected + 1))/${csp_count}"
  keys="${CSP_C_KEY}j/k${CSP_C_RESET}${CSP_C_DIM} move   ${CSP_C_KEY}Enter${CSP_C_RESET}${CSP_C_DIM} open   ${CSP_C_KEY}n${CSP_C_RESET}${CSP_C_DIM} new   ${CSP_C_KEY}d${CSP_C_RESET}${CSP_C_DIM} del   ${CSP_C_KEY}R${CSP_C_RESET}${CSP_C_DIM} reload   ${CSP_C_KEY}q${CSP_C_RESET}${CSP_C_DIM} quit${CSP_C_RESET}"
  pos="${CSP_C_DIM}${pos_plain}${CSP_C_RESET}"
  gap=$(( CSP_INNER - $(csp_display_width "$keys_plain") - $(csp_display_width "$pos_plain") ))
  [ "$gap" -lt 1 ] && gap=1
  printf '%s%s %s %s%s\n' \
    "$CSP_C_FRAME" "$CSP_BX_V" \
    "${keys}$(csp_repeat ' ' "$gap")${pos}" \
    "$CSP_C_FRAME" "$CSP_BX_V" "$CSP_C_RESET"
  csp_frame_bot
}

# csp_open ID PROJECT LABEL — open a session through the active backend.
#
# The two backends need opposite terminal handling, and getting this wrong is
# what would wedge the terminal, so it is centralised here:
#
#   • hub  — we must give the terminal back to Claude, run it, and then take the
#     terminal BACK when Claude exits so the menu can redraw. So: restore the
#     terminal, run the session (which blocks until it exits), then re-enter raw
#     mode and reload the list. Control naturally returns to the main loop.
#
#   • tmux — we hand off to tmux (attach/switch) and then exit the picker: tmux
#     owns the screen from here, and the other sessions keep running in their
#     own windows. We restore the terminal first so tmux starts from a clean
#     state. If tmux FAILS (server won't start, window couldn't be created), we
#     do NOT silently vanish — we fall back to hub for this one launch so the
#     user still gets their session, then return to the menu.
csp_open() {
  local id="$1" project="$2" label="$3"
  if [ "$CSP_ACTIVE_BACKEND" = "tmux" ]; then
    csp_restore_terminal
    if csp_tmux_open "$id" "$project" "$label"; then
      exit 0
    fi
    # tmux launch failed — tell the user and fall back to running it here.
    printf 'tmux could not open the session; running it here instead.\n' >&2
    csp_hub_open "$id" "$project"
    csp_enter_raw_mode
    csp_load_sessions
    return 0
  fi
  # hub mode
  csp_restore_terminal
  csp_hub_open "$id" "$project"
  csp_enter_raw_mode
  csp_load_sessions
}

# csp_confirm PROMPT — ask a yes/no question and return 0 only for an explicit
# "y". We briefly leave raw mode so the user can see what they type and use
# Backspace, show the cursor, then restore raw mode afterwards. Used to guard
# the destructive delete action.
csp_confirm() {
  local prompt="$1" answer
  # Drop back to cooked mode + visible cursor for a normal line of input.
  [ -n "$csp_saved_stty" ] && stty "$csp_saved_stty" 2>/dev/null
  printf '\033[?25h'
  printf '\n%s' "$prompt" > /dev/tty
  IFS= read -r answer < /dev/tty
  csp_enter_raw_mode
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

# csp_action_delete INDEX — confirm, then permanently delete the selected
# session's transcript file, then reload the list. Deleting throws away that
# conversation's history, so we always confirm first and we never touch a live
# session (one Claude is currently running) — killing its file mid-run would be
# surprising; the user should quit that Claude first.
csp_action_delete() {
  local idx="$1" title file
  [ "$csp_count" -gt 0 ] || return 0
  title="${csp_titles[$idx]}"
  file="${csp_files[$idx]}"

  if [ "${csp_lives[$idx]}" = "1" ]; then
    csp_restore_terminal
    printf '\n"%s" is running right now — quit that Claude first, then delete.\n' "$title" > /dev/tty
    printf 'Press Enter to continue…' > /dev/tty; IFS= read -r _ < /dev/tty
    csp_enter_raw_mode
    return 0
  fi

  if csp_confirm "Delete session \"$title\"? This erases its history. [y/N] "; then
    if csp_delete_session_file "$file"; then
      # Keep the cursor sensible: if we deleted the last row, step up one.
      [ "$idx" -ge "$((csp_count - 1))" ] && [ "$idx" -gt 0 ] && csp_selected_after_delete=$((idx - 1))
    fi
    csp_load_sessions
  fi
}

# --- Main loop ---------------------------------------------------------------
csp_main() {
  if ! command -v claude >/dev/null 2>&1; then
    printf 'The `claude` command was not found on your PATH.\n' >&2
    printf 'Install Claude Code first: https://claude.com/claude-code\n' >&2
    exit 1
  fi

  local selected=0 key label

  # Load the session list BEFORE switching the terminal to raw mode. Loading
  # reads files and can take a moment on a big store; doing it first means the
  # terminal is never sitting in raw mode during that work (so nothing can leave
  # it raw if loading is interrupted), and the first frame appears fully built.
  csp_load_sessions
  csp_enter_raw_mode
  while :; do
    selected=$(csp_clamp_index "$selected" "$csp_count")
    csp_draw "$selected"
    key=$(csp_read_key)
    case "$key" in
      j) selected=$(csp_clamp_index "$((selected + 1))" "$csp_count") ;;
      k) selected=$(csp_clamp_index "$((selected - 1))" "$csp_count") ;;
      g) selected=0 ;;
      G) selected=$(csp_clamp_index "$((csp_count - 1))" "$csp_count") ;;
      $'\n'|$'\r'|'')
         if [ "$csp_count" -gt 0 ]; then
           # A tmux window name can't contain much; use the short project path.
           label="${csp_projects[$selected]}"
           csp_open "${csp_ids[$selected]}" "${csp_fullprojects[$selected]}" "$label"
         fi ;;
      n) # Start a brand-new session (in the current directory).
         csp_open "new" "$PWD" "new" ;;
      d|x) # Delete the selected session (asks to confirm first).
         csp_selected_after_delete=""
         csp_action_delete "$selected"
         [ -n "$csp_selected_after_delete" ] && selected="$csp_selected_after_delete" ;;
      R|l) csp_load_sessions ;;
      q) break ;;
    esac
  done
}

# Run the picker only when this file is executed directly. When a test sources
# it (CSP_SOURCED_FOR_TEST=1) we skip main so individual functions like
# csp_read_key can be exercised in isolation without launching the whole TUI.
if [ -z "${CSP_SOURCED_FOR_TEST:-}" ]; then
  csp_main "$@"
fi
