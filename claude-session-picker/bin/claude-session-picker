#!/usr/bin/env bash
# =============================================================================
# claude-session-picker — a menu for resuming your Claude Code sessions.
#
# WHAT IT DOES (plain language):
#   Claude Code saves every conversation you have. Over time you build up dozens
#   of them across different projects, and the only way back into one is to
#   remember its id. This tool shows all your sessions in a simple keyboard menu
#   — newest first, with a title, which project it belongs to, and how long ago
#   it was active — and lets you jump straight back into any one. A "●" marks
#   sessions that have a live Claude running right now.
#
#   It replaces the habit of keeping a dozen terminal tabs open "so you don't
#   lose" a session: everything is one keypress away from one window.
#
# WHY IT NEEDS NOTHING INSTALLED:
#   It reads Claude's own files under ~/.claude and resumes with the `claude`
#   command you already have. No tmux, no fzf, no Homebrew. It runs on a bare
#   remote Linux host exactly as it does on a Mac.
#
# HOW IT STAYS SAFE:
#   - All decision logic lives in lib/core.sh as pure, unit-tested functions.
#   - All disk/process access lives in lib/sessions.sh.
#   - This file only wires input → logic → drawing. It sets strict shell flags,
#     bounds every loop, and restores the terminal on ANY exit path so a crash
#     can never leave your terminal in a broken state.
# =============================================================================

set -u  # Treat use of an unset variable as an error — catches typos early.
#
# ERROR-HANDLING PHILOSOPHY (why some failures are silent by design):
#   • We intentionally do NOT use `set -e`. This is an interactive loop where
#     non-zero is normal control flow — a `read` that times out, a `grep` with
#     no match, tmux reporting "no such session". `set -e` would abort the whole
#     picker (possibly mid-draw, leaving the terminal half-restored). Please
#     don't add it.
#   • READS are best-effort and silent: anything that only gathers data to
#     display (parsing a title, statting a file, reading hook state) degrades to
#     an empty/placeholder value rather than erroring — a read-only tool should
#     never nag about a file it merely failed to summarise.
#   • ACTIONS that change or launch something check their result and surface it:
#     delete verifies the path and reports refusal; opening a session checks the
#     backend and falls back to hub; the terminal is restored on every exit path.
# In short: displaying is forgiving, doing is checked.

# Version, reported by --version. Bump this in the same commit as user-visible
# changes and add a matching CHANGELOG.md entry; because the install is a
# symlink updated in place by `git pull`, this is how a user (or a bug report)
# knows exactly which build they're on.
CSP_VERSION="1.2.0"

# --- Locate our own library files, following symlinks -----------------------
# The installer symlinks this script into a bin dir, so we resolve the real
# location to find lib/ next to it. We start from ${BASH_SOURCE[0]} rather than
# $0 because it names THIS file both when the script is run normally and when a
# test sources it (where $0 would instead be the shell/bats runner).
csp_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$csp_self" ]; do
  csp_link_target=$(readlink "$csp_self")
  case "$csp_link_target" in
    /*) csp_self="$csp_link_target" ;;                        # absolute link
    *)  csp_self="$(dirname "$csp_self")/$csp_link_target" ;; # relative link
  esac
done
CSP_ROOT="$(cd "$(dirname "$csp_self")/.." && pwd)"

# shellcheck source=../lib/core.sh
. "$CSP_ROOT/lib/core.sh"
# shellcheck source=../lib/sessions.sh
. "$CSP_ROOT/lib/sessions.sh"
# shellcheck source=../lib/backend.sh
. "$CSP_ROOT/lib/backend.sh"

# Where we remember the user's backend choice between runs (set by the 't' key
# in the menu). A tiny one-line file; overridable for tests.
CSP_PREF_FILE="${CSP_PREF_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-session-picker/backend}"

# csp_load_backend_pref — read the saved backend preference ("hub"/"tmux"), or
# print nothing if there isn't a valid one. Always returns 0: "no preference"
# is a normal outcome, not an error, so this stays safe to use in a command
# substitution even under `set -e`.
#
# The `read` is wrapped in a { …; } group with the 2>/dev/null on the GROUP, not
# on the redirection: a failed input redirection (e.g. an unreadable pref file)
# is reported by the shell itself before the command runs, so a redirect on the
# command alone wouldn't catch it — grouping does. We also cap the read at a few
# bytes (bounded input) and strip a trailing CR so a hand-edited CRLF file still
# loads, since the docs invite editing this path.
csp_load_backend_pref() {
  local v=""
  if [ -f "$CSP_PREF_FILE" ]; then
    # No `|| v=""`: `read -n` returns non-zero at EOF-without-newline but has
    # already set v; clearing it would drop a value from a newline-less file.
    { IFS= read -r -n 16 v < "$CSP_PREF_FILE"; } 2>/dev/null
  fi
  v="${v%$'\r'}"          # tolerate CRLF from a hand-edited file
  v="${v%% *}"            # tolerate a trailing space/comment
  if csp_backend_is_valid "$v" && [ -n "$v" ]; then
    printf '%s' "$v"
  fi
  return 0
}

# csp_save_backend_pref VALUE — persist the chosen backend so it sticks next
# time. Best-effort: if the directory can't be made or written, we just skip it
# (the choice still applies for this run). The write is grouped so a redirection
# failure to an unwritable path is suppressed too (same reason as the read).
csp_save_backend_pref() {
  local v="$1" dir
  dir=$(dirname "$CSP_PREF_FILE")
  mkdir -p "$dir" 2>/dev/null || return 0
  { printf '%s\n' "$v" > "$CSP_PREF_FILE"; } 2>/dev/null || true
}

# Decide the starting backend. Precedence:
#   1. CSP_BACKEND env var, if set and valid (an explicit per-run override)
#   2. the saved preference from the 't' toggle
#   3. the default (hub)
# A bogus CSP_BACKEND is not silently ignored: we stash a note in
# CSP_STARTUP_NOTICE and show it on the first frame's mode line, because a
# message printed to stderr here would be wiped by the screen-clear when we
# enter raw mode.
CSP_STARTUP_NOTICE=""
if [ -n "${CSP_BACKEND:-}" ] && ! csp_backend_is_valid "${CSP_BACKEND}"; then
  CSP_STARTUP_NOTICE="CSP_BACKEND=\"${CSP_BACKEND}\" not recognised (use hub/tmux) — ignored"
fi
if [ -n "${CSP_BACKEND:-}" ] && csp_backend_is_valid "${CSP_BACKEND}"; then
  CSP_BACKEND_CHOICE="${CSP_BACKEND}"
else
  CSP_BACKEND_CHOICE=$(csp_load_backend_pref)
fi
CSP_ACTIVE_BACKEND=$(csp_choose_backend \
  "$(csp_tmux_available && echo 1 || echo 0)" \
  "$(csp_inside_tmux && echo 1 || echo 0)" \
  "${CSP_BACKEND_CHOICE:-}")

# --- Colours & box-drawing ---------------------------------------------------
# The menu is drawn as a framed "GUI-style" panel. All the escape codes live
# here so the look is defined in one place. Colour is turned OFF automatically
# when output is not a terminal, or when the user sets NO_COLOR (a widely
# respected convention) or CSP_NO_COLOR — so the tool stays readable and its
# output stays clean everywhere.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -z "${CSP_NO_COLOR:-}" ]; then
  CSP_C_RESET=$'\033[0m'
  CSP_C_FRAME=$'\033[38;5;244m'   # dim grey for the box border
  CSP_C_TITLE=$'\033[1;38;5;39m'  # bold blue for the app title
  CSP_C_HEADER=$'\033[38;5;250m'  # column headings
  CSP_C_SEL=$'\033[7m'            # reverse video for the selected row
  CSP_C_LIVE=$'\033[38;5;42m'     # green for the ● working marker
  CSP_C_ATTN=$'\033[1;38;5;220m'  # bold yellow for the ✳ needs-attention marker
  CSP_C_DIM=$'\033[38;5;244m'     # dim for ages / hints
  CSP_C_KEY=$'\033[1;38;5;250m'   # bold for key names in the status bar
else
  CSP_C_RESET=""; CSP_C_FRAME=""; CSP_C_TITLE=""; CSP_C_HEADER=""
  CSP_C_SEL=""; CSP_C_LIVE=""; CSP_C_ATTN=""; CSP_C_DIM=""; CSP_C_KEY=""
fi

# Box-drawing characters (Unicode). These render the frame. The set is kept
# complete for readers even though the frame currently uses only horizontal
# rules and junctions (no vertical sides — see the frame-style note below), so
# CSP_BX_V is intentionally defined but unused.
CSP_BX_TL="┌"; CSP_BX_TR="┐"; CSP_BX_BL="└"; CSP_BX_BR="┘"
CSP_BX_H="─";  CSP_BX_V="│";  CSP_BX_ML="├"; CSP_BX_MR="┤"

# --- Terminal handling -------------------------------------------------------
# We switch the terminal into "raw-ish" mode to read single keypresses, and we
# ALWAYS put it back. The trap guarantees restoration even if we crash or are
# killed — this is the core of "never leave the terminal broken". The trap is
# installed BEFORE we ever change terminal modes, so there is no window in which
# a failure could skip the cleanup.
# csp_saved_stty holds the PRISTINE terminal settings, captured exactly ONCE
# before we ever touch the terminal (see csp_capture_pristine_stty). We must
# never re-capture after that: if we did, and a crashed Claude left the terminal
# in a broken mode, we would "restore" that broken mode. Capturing once means we
# always put the terminal back the way the user's shell handed it to us.
csp_saved_stty=""
csp_stty_captured=0
csp_raw_active=0        # 1 once we've put the terminal into raw mode

# The terminal device we talk to for interactive prompts (delete confirmation,
# "press Enter to continue"). It defaults to the real controlling terminal, but
# is overridable so tests can point it at a pipe/file — a plain `< /dev/null`
# on the command can't redirect /dev/tty, which would otherwise make a prompt
# block forever in a headless test run.
CSP_TTY="${CSP_TTY:-/dev/tty}"

# csp_tty_print TEXT… — write a prompt to the terminal (no trailing newline).
csp_tty_print() {
  printf '%s' "$*" > "$CSP_TTY" 2>/dev/null || true
}

# csp_tty_readline VARNAME — read one line from the terminal into VARNAME.
# Returns non-zero (and leaves VARNAME empty) if the terminal can't be read, so
# a caller in a non-interactive context degrades to "no input" instead of
# hanging.
csp_tty_readline() {
  local __var="$1" __line=""
  if [ -r "$CSP_TTY" ] || [ "$CSP_TTY" != "/dev/tty" ]; then
    IFS= read -r __line < "$CSP_TTY" 2>/dev/null || __line=""
  fi
  # Assign to the caller's variable via printf -v (bash 3.1+, which we target)
  # rather than eval — no chance of the value being re-interpreted as code.
  printf -v "$__var" '%s' "$__line"
}

csp_capture_pristine_stty() {
  # Capture only the first time; later calls are deliberate no-ops.
  [ "$csp_stty_captured" = "1" ] && return 0
  csp_saved_stty=$(stty -g 2>/dev/null) || csp_saved_stty=""
  csp_stty_captured=1
}

# csp_restore_terminal — put the terminal fully back to normal. It is safe to
# call more than once and on any exit path. It undoes everything a raw-mode TUI
# (ours or a crashed Claude we returned from) could have left on:
#   • show the cursor again
#   • leave the alternate screen buffer, and turn mouse reporting off — a
#     crashed Claude often leaves these on, which otherwise spews escape
#     garbage or hides the shell prompt
#   • restore the exact saved settings; if we never captured any (or capture
#     failed), fall back to `stty sane`, a known-good cooked mode, so the user
#     is never left with no echo / no Ctrl-C.
csp_restore_terminal() {
  # Nothing to undo if we never touched the terminal (e.g. exiting from
  # --version/--help, or a load-time error). Staying silent here keeps that
  # output clean when piped or grepped — no stray escape sequences.
  [ "$csp_raw_active" = "1" ] || return 0
  csp_raw_active=0
  printf '\033[?25h\033[?1049l\033[?1000l\033[?1006l' 2>/dev/null
  if [ -n "$csp_saved_stty" ]; then
    stty "$csp_saved_stty" 2>/dev/null || stty sane 2>/dev/null
  else
    stty sane 2>/dev/null
  fi
}

# Interrupt handling has ONE designed outcome: restore the terminal and exit.
# Falling back into the raw-mode loop after an interrupt (the previous bug)
# could leave the terminal cooked while the menu kept running, or even open a
# session on an empty keypress. We give INT/TERM/QUIT/HUP/PIPE a single clean
# destination. Not installed when a test merely sources this file.
csp_on_signal() {
  csp_restore_terminal
  exit 130
}
if [ -z "${CSP_SOURCED_FOR_TEST:-}" ]; then
  trap 'csp_restore_terminal' EXIT
  trap 'csp_on_signal' INT TERM QUIT HUP PIPE
fi

csp_enter_raw_mode() {
  csp_capture_pristine_stty           # captures once; safe to call repeatedly
  csp_raw_active=1                     # from here, restore has real work to do
  stty -echo -icanon min 1 time 0 2>/dev/null
  # Hide the cursor and clear the screen ONCE. From here on csp_draw repaints by
  # homing the cursor (not clearing), so there's no flicker; this initial clear
  # just gives it a clean canvas to home onto.
  printf '\033[?25l\033[2J\033[H'
}

# csp_read_key — read one keypress and return a single normalised token:
#   j / k        down / up      (from 'j','k' or the ↓/↑ arrows)
#   g / G        first / last
#   n            new session
#   R / l        reload
#   q            quit           (also a bare Esc)
#   _            "ignore me"    (any other arrow / escape sequence)
#   <char>       any other single character, passed through unchanged
#
# The tricky part is escape sequences. An arrow key sends three-plus bytes
# (ESC [ A). Home/End/PageUp send ESC [ 1 ~ etc., and a stray mouse click from a
# terminal left in mouse-reporting mode sends ESC [ M followed by raw bytes.
# The previous version read a FIXED two bytes after ESC, which left the tail of
# longer sequences (the '~', the mouse coordinates) sitting in the input to be
# misread as if the user had typed them — a stray click could even quit the
# picker. We instead CONSUME THE WHOLE sequence: after ESC-[ we read bytes until
# the terminating "final byte" (in the 0x40–0x7E range), so nothing is left
# behind. Only a bare Esc — an ESC with nothing following — quits.
csp_read_key() {
  local k rest c
  IFS= read -r -n 1 k 2>/dev/null || { printf 'q'; return; }

  if [ "$k" != $'\033' ]; then
    printf '%s' "$k"
    return
  fi

  # We saw ESC. Read the next byte (short timeout) to see if a sequence follows.
  IFS= read -r -n 1 -t 1 rest 2>/dev/null
  if [ -z "$rest" ]; then
    printf 'q'                     # bare Esc → quit
    return
  fi
  if [ "$rest" != '[' ] && [ "$rest" != 'O' ]; then
    printf '_'                     # ESC + something we don't handle → ignore
    return
  fi

  # It's a CSI/SS3 sequence. Read the (up to few) parameter/final bytes, mapping
  # the arrows and discarding everything else. Loop until a final byte or EOF.
  IFS= read -r -n 1 -t 1 c 2>/dev/null
  case "$c" in
    'A') printf 'k'; return ;;     # up
    'B') printf 'j'; return ;;     # down
    'C'|'D') printf '_'; return ;; # right/left → no-op
  esac
  # Longer sequence (e.g. Home = ESC [ 1 ~, or a mouse report): drain to its end
  # so no leftover bytes are read as keystrokes, then report "ignore".
  while [ -n "$c" ]; do
    case "$c" in
      [A-Za-z~]) break ;;          # a final byte — sequence complete
    esac
    IFS= read -r -n 1 -t 1 c 2>/dev/null
  done
  printf '_'
}

# --- In-memory session model -------------------------------------------------
# We keep parallel indexed arrays (bash 3.2 has no associative arrays). Every
# access is guarded by csp_clamp_index so an out-of-range read is impossible.
csp_ids=()
csp_titles=()
csp_titles_full=()    # untruncated title, used only for the '/' filter haystack
csp_projects=()
csp_fullprojects=()   # full cwd path, kept for the resume `cd` and filter haystack
csp_files=()          # on-disk .jsonl path, kept for delete
csp_ages=()
csp_states=()         # per-session hook state: working/waiting/"" (for ●/✳)
csp_markers=()        # per-session resolved marker glyph (●/✳/space)
csp_rows=()           # fully-formatted row body, precomputed once at load
csp_line_normal=()    # display-ready line (marker tinted), per row
csp_line_selected=()  # display-ready line (reverse video + cursor), per row
csp_count=0
CSP_HAVE_STATE=0      # 1 if the hooks' state dir exists (●/✳ fully active)
CSP_ATTENTION_COUNT=0 # how many sessions currently show ✳ (needs-you)

# --- Filtered view -----------------------------------------------------------
# Type-to-filter ('/') never touches the model arrays above; instead csp_view
# holds the MODEL INDICES currently shown, in order. With no filter it is simply
# 0,1,2,…; with a filter it is the matching subset. The interactive layer selects
# and draws by VIEW POSITION (0..csp_view_count-1) and maps to a model index
# through csp_view only where it actually reads the model (open, delete, draw).
# This keeps the precomputed per-row lines (indexed by model position) reusable
# and confines the indirection to a few well-marked spots.
csp_view=()           # csp_view[view_pos] = model index shown at that position
csp_view_count=0      # number of rows currently shown (len of csp_view)
CSP_FILTER=""         # active filter needle ("" = show everything)

# csp_rebuild_view — recompute csp_view from CSP_FILTER. Called after a load and
# whenever the filter changes. With an empty filter it's the identity mapping;
# otherwise it uses the pure csp_filter_indices over a per-row haystack of
# "full-title␠full-project-path" so a search matches either column.
#
# The haystack uses the FULL title and the FULL cwd (csp_titles_full /
# csp_fullprojects), NOT the display strings: the display title is truncated to
# 60 columns and the display project keeps only the last two path components, so
# filtering on those would silently fail to match text past the title cut or a
# parent directory the display dropped — contradicting the docs' "type any part
# of a title or project path". Matching the full strings makes that promise true.
csp_rebuild_view() {
  csp_view=(); csp_view_count=0
  if [ -z "$CSP_FILTER" ]; then
    local i=0
    while [ "$i" -lt "$csp_count" ]; do
      csp_view[$i]="$i"; i=$(( i + 1 ))
    done
    csp_view_count="$csp_count"
    return 0
  fi
  # Build the haystack (one line per session, model order) then filter.
  local hay="" i=0
  while [ "$i" -lt "$csp_count" ]; do
    hay="${hay}${csp_titles_full[$i]} ${csp_fullprojects[$i]}"$'\n'
    i=$(( i + 1 ))
  done
  hay="${hay%$'\n'}"                       # drop the trailing newline
  local idx
  while IFS= read -r idx; do
    [ -z "$idx" ] && continue
    csp_view[$csp_view_count]="$idx"
    csp_view_count=$(( csp_view_count + 1 ))
  done <<EOF
$(csp_filter_indices "$CSP_FILTER" "$hay")
EOF
  return 0
}

# csp_markers_nl — print the markers of the CURRENTLY VISIBLE rows (view order),
# one per line, for the pure csp_next_attention / csp_count_attention helpers.
# Iterating the view (not the model) keeps the '*' jump and the urgency badge
# consistent with what's on screen under a filter. One small fork on load or a
# '*' keypress — never the hot draw path.
csp_markers_nl() {
  local p=0 mi
  while [ "$p" -lt "$csp_view_count" ]; do
    mi="${csp_view[$p]}"
    printf '%s\n' "${csp_markers[$mi]:-}"
    p=$(( p + 1 ))
  done
}

# csp_precompute_lines INDEX ROW — build the two display-ready line forms for a
# row (see the comment at the call site). Depends on the colour variables and on
# CSP_INNER (for the selected row's full-width reverse-video bar), so it is also
# re-run for every row by csp_build_chrome when the terminal width changes.
csp_precompute_lines() {
  local idx="$1" row="$2" mk tint padded

  # Normal line: colour just the marker glyph (3rd char: after "  " cursor gap).
  mk="${row:2:1}"; tint=""
  case "$mk" in
    "$CSP_MARKER_ATTENTION") tint="$CSP_C_ATTN" ;;
    "$CSP_MARKER_WORKING")   tint="$CSP_C_LIVE" ;;
  esac
  if [ -n "$tint" ]; then
    csp_line_normal[$idx]=" ${row:0:2}${tint}${mk}${CSP_C_RESET}${row:3}"
  else
    csp_line_normal[$idx]=" ${row}"
  fi

  # Selected line: cursor pointer + full-width reverse-video bar.
  csp_fit_field "› ${row:2}" "$CSP_INNER"; padded="$__csp_fit"
  csp_line_selected[$idx]="${CSP_C_SEL} ${padded}${CSP_C_RESET}"
}

# csp_load_sessions — build the model from Claude's session store. Enforces the
# CSP_MAX_SESSIONS cap (via csp_list_session_files) so memory stays bounded.
csp_load_sessions() {
  local line file id meta title fulltitle fullcwd project mtime now running is_live marker row
  local tab=$'\t'
  csp_ids=(); csp_titles=(); csp_titles_full=(); csp_projects=(); csp_fullprojects=()
  csp_ages=(); csp_files=(); csp_states=(); csp_rows=()
  csp_markers=(); csp_line_normal=(); csp_line_selected=()
  csp_count=0
  now=$(csp_now_epoch)
  running=$(csp_running_session_ids)
  # If the hooks have never recorded anything, the state dir won't exist — skip
  # the per-session state lookups entirely in that (common) case.
  local have_state=0
  [ -d "$CSP_STATE_DIR" ] && have_state=1
  CSP_HAVE_STATE="$have_state"   # expose to the draw layer (legend / first-run hint)

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    # Each line is "<mtime> <path>" (see csp_list_session_files_with_mtime): we
    # already have the mtime from the sort step, so we don't stat the file again.
    mtime="${line%% *}"
    file="${line#* }"
    case "$mtime" in ''|*[!0-9]*) mtime=0 ;; esac    # guard non-numeric
    # Derive the id inline (basename minus .jsonl) — avoids a fork per file.
    id="${file##*/}"; id="${id%.jsonl}"
    # One read per file for both title and cwd (see csp_session_meta), returned
    # as "title<TAB>cwd". Split on that tab inline (using a $'\t' variable so the
    # separator is visible in the source) rather than via two csp_field forks.
    meta=$(csp_session_meta "$file")
    fullcwd="${meta#*"$tab"}"; [ "$fullcwd" = "$meta" ] && fullcwd=""
    fulltitle="${meta%%"$tab"*}"                       # pre-display-truncation title
    title=$(csp_truncate "$fulltitle" "$CSP_MAX_TITLE_LEN")
    project=$(csp_short_path "$fullcwd")
    is_live=0
    csp_is_live "$id" "$running" && is_live=1

    csp_ids[$csp_count]="$id"
    csp_titles[$csp_count]="$title"
    # Full title kept ONLY for the '/' filter haystack, so a query can match past
    # the 60-column display truncation (the docs promise "any part of a title").
    csp_titles_full[$csp_count]="$fulltitle"
    csp_projects[$csp_count]="$project"
    csp_ages[$csp_count]="$(csp_humanize_age "$((now - mtime))")"
    # Per-session hook state (working/waiting) for the ●/✳ marker; empty if the
    # hooks aren't installed, in which case the marker falls back to live/blank.
    # Skip the lookup entirely when no state dir exists (hooks never ran).
    if [ "$have_state" = "1" ]; then
      csp_states[$csp_count]="$(csp_read_state "$id")"
    else
      csp_states[$csp_count]=""
    fi
    # Remember the full project path alongside the id, for the resume `cd`.
    csp_fullprojects[$csp_count]="$fullcwd"
    # Remember the on-disk file so we can delete the session if asked.
    csp_files[$csp_count]="$file"

    # PRECOMPUTE the two display-ready line forms ONCE here, at load time. A
    # row's content (marker + aligned title/project/age) is identical on every
    # draw — only WHICH row is selected changes — so doing the width/column and
    # tinting work per keypress is what made moving feel slow. We render each row
    # once into:
    #   csp_line_normal[i]   — plain row, live/attention marker tinted
    #   csp_line_selected[i] — same content padded to full width in reverse video
    #                          with the "› " cursor pointer
    # and the draw loop just appends the right one (no forks, no width work).
    marker=$(csp_marker_for_session "$is_live" "${csp_states[$csp_count]}")
    csp_markers[$csp_count]="$marker"
    row=$(csp_format_line "$marker" "$title" "$project" "${csp_ages[$csp_count]}" 0)
    csp_rows[$csp_count]="$row"
    csp_precompute_lines "$csp_count" "$row"

    csp_count=$((csp_count + 1))
  done <<EOF
$(csp_list_session_files_with_mtime)
EOF

  # Recompute which rows are visible under the current filter (identity when no
  # filter is set). Keeps csp_view in sync after a reload/delete. Must run BEFORE
  # the attention tally, which counts over the visible view.
  csp_rebuild_view
  csp_retally_attention
}

# csp_retally_attention — recompute CSP_ATTENTION_COUNT over the CURRENTLY VISIBLE
# view. Done once per load / filter change (not per draw), for the status-bar
# urgency badge and so '*' has something to target. Named so the two callers
# (load, filter) can't drift.
csp_retally_attention() {
  CSP_ATTENTION_COUNT=$(csp_count_attention "$(csp_markers_nl)")
}

# csp_visible_rows — how many session rows fit on the current terminal, leaving
# room for the two header lines and a footer.
#
# We read the height from `stty size` FIRST, because it reports the real
# current size of the terminal device. `tput lines` is only a fallback: it can
# return a stale terminfo default (e.g. 24) inside a resized window, which would
# make us draw more rows than fit and push the header off-screen. If neither
# works (e.g. output isn't a terminal at all), we assume a conservative 24.
csp_visible_rows() {
  local rows=""
  # `stty size` prints "ROWS COLS"; take the first number.
  rows=$(stty size 2>/dev/null | { read -r r _ 2>/dev/null; printf '%s' "$r"; })
  case "$rows" in ''|*[!0-9]*) rows=$(tput lines 2>/dev/null) ;; esac
  case "$rows" in ''|*[!0-9]*) rows=24 ;; esac
  # Reserve the frame chrome: top border, mode line, marker legend, divider,
  # column header, divider, status bar, bottom border = 8 lines (9 for a little
  # slack).
  rows=$((rows - 9))
  [ "$rows" -lt 1 ] && rows=1
  printf '%d' "$rows"
}

# csp_term_cols — the terminal width in columns (stty first, then tput, then 80).
csp_term_cols() {
  local cols=""
  cols=$(stty size 2>/dev/null | { read -r _ c 2>/dev/null; printf '%s' "$c"; })
  case "$cols" in ''|*[!0-9]*) cols=$(tput cols 2>/dev/null) ;; esac
  case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
  printf '%d' "$cols"
}

# csp_repeat STR N — print STR repeated N times (used to draw border rules).
csp_repeat() {
  local str="$1" n="$2" out=""
  while [ "$n" -gt 0 ]; do out="$out$str"; n=$(( n - 1 )); done
  printf '%s' "$out"
}

# The content width used for the horizontal rules and column layout, set once
# per draw to fit the terminal.
CSP_INNER=82

# --- Frame style: horizontal rules only, NO vertical side borders ------------
# We deliberately dropped the left/right "│" borders. Two reasons: (1) a right
# border can only line up if every row's total display width is identical, and
# CJK glyphs render at widths some fonts/terminals disagree with, so the right
# edge drifted; (2) the left columns already align perfectly on their own. So we
# keep only the top/middle/bottom horizontal rules — clean, modern, and immune
# to that width ambiguity.
#
# Every draw helper APPENDS to the global CSP_BUF instead of printing, so the
# whole screen is emitted in a single write (double buffering) — that is what
# removes the flicker you'd get from clearing and redrawing line by line.
CSP_BUF=""

# csp_buf_line TEXT — add one line to the frame buffer, clearing to end-of-line
# (\033[K) so leftover characters from a previous, longer frame are erased
# without needing a full-screen clear (which is what caused flicker).
csp_buf_line() {
  CSP_BUF="${CSP_BUF}$1"$'\033[K\n'
}

# csp_rule POSITION [TITLE] — append a horizontal rule. POSITION is top/mid/bot,
# choosing the corner/junction glyphs; the top rule embeds the app title.
csp_rule() {
  local pos="$1" title="${2:-}" left right tw fill
  case "$pos" in
    top) left="$CSP_BX_TL"; right="$CSP_BX_TR" ;;
    mid) left="$CSP_BX_ML"; right="$CSP_BX_MR" ;;
    *)   left="$CSP_BX_BL"; right="$CSP_BX_BR" ;;
  esac
  # Only embed the title when there's room for "─ " + at least one title column
  # + " " within CSP_INNER (i.e. CSP_INNER >= 4). On an absurdly narrow frame
  # (a few-column tmux micro-pane) we drop the title entirely and emit a plain
  # rule, so the top border is never wider than the mid/bottom ones.
  if [ -n "$title" ] && [ "$CSP_INNER" -ge 4 ]; then
    # The embedded title takes "─ " + title + " " = title width + 3 columns of the
    # CSP_INNER budget. On a narrow frame we truncate the title to what's left so
    # the rule can't exceed the width. Normal widths are unaffected.
    local tmax=$(( CSP_INNER - 3 ))
    [ "$tmax" -lt 1 ] && tmax=1
    title=$(csp_truncate_display "$title" "$tmax")
    tw=$(csp_display_width "$title")
    fill=$(( CSP_INNER - tw - 3 ))       # "─ " + title + " " then dashes
    [ "$fill" -lt 0 ] && fill=0
    csp_buf_line "${CSP_C_FRAME}${left}${CSP_BX_H} ${CSP_C_TITLE}${title}${CSP_C_RESET}${CSP_C_FRAME} $(csp_repeat "$CSP_BX_H" "$fill")${right}${CSP_C_RESET}"
  else
    csp_buf_line "${CSP_C_FRAME}${left}$(csp_repeat "$CSP_BX_H" "$(( CSP_INNER ))")${right}${CSP_C_RESET}"
  fi
}

# csp_buf_row CONTENT [SELECTED] [STYLE] — append one content row (no side
# borders). A selected row is padded to the full width and shown in reverse
# video so the highlight bar spans the whole line; other rows are printed as-is
# (their left columns already align) with the live ● tinted green.
csp_buf_row() {
  local content="$1" selected="${2:-0}" style="${3:-}" padded
  if [ "$selected" = "1" ]; then
    # csp_fit_field returns via the global __csp_fit — no fork, unlike a
    # $(csp_pad_display …) command substitution. This runs for every drawn row.
    csp_fit_field "$content" "$CSP_INNER"; padded="$__csp_fit"
    csp_buf_line "${CSP_C_SEL} ${padded}${CSP_C_RESET}"
  elif [ -n "$style" ]; then
    csp_fit_field "$content" "$CSP_INNER"
    # Strip trailing pad so a styled line (mode/header) isn't a full-width block.
    local s="$__csp_fit"; while [ "${s% }" != "$s" ]; do s="${s% }"; done
    csp_buf_line "${style} ${s}${CSP_C_RESET}"
  else
    csp_fit_field "$content" "$CSP_INNER"
    content="$__csp_fit"
    # trailing pad is desired here? no — rows shouldn't be full-width padded;
    # strip it so the plain row is its natural width.
    while [ "${content% }" != "$content" ]; do content="${content% }"; done
    # Colour ONLY the marker, at its known position, never a content-wide search
    # (a title can legitimately contain ● or ✳, and we must not tint that). The
    # row from csp_format_line is: 2-char cursor pointer, then the 1-char marker,
    # then the rest. So the marker is exactly the 3rd character. Recolouring one
    # fixed-width glyph after truncation is layout-safe.
    local mk="${content:2:1}" tint=""
    case "$mk" in
      "$CSP_MARKER_ATTENTION") tint="$CSP_C_ATTN" ;;
      "$CSP_MARKER_WORKING")   tint="$CSP_C_LIVE" ;;
    esac
    if [ -n "$tint" ]; then
      content="${content:0:2}${tint}${mk}${CSP_C_RESET}${content:3}"
    fi
    csp_buf_line " ${content}"
  fi
}

# --- Cached, terminal-size-dependent chrome ----------------------------------
# These are recomputed ONLY when the terminal size changes (see csp_build_chrome),
# not on every keypress — computing them per draw is what made movement slow.
CSP_CHROME_COLS=""      # last cols we built chrome for ("" = not built yet)
CSP_CHROME_ROWS=""      # last visible-row count
CSP_CHROME_TOP=""       # top rule line (with title), ready for csp_buf_line
CSP_CHROME_MID=""       # middle rule line
CSP_CHROME_BOT=""       # bottom rule line
CSP_CHROME_HEADER=""    # column-heading row (styled), ready for csp_buf_line
CSP_CHROME_VISIBLE=1    # how many session rows fit
CSP_CHROME_KEYS=""      # coloured FULL key-hints string for the status bar
CSP_CHROME_KEYS_W=0     # display width of the PLAIN full key-hints (for spacing)
CSP_CHROME_KEYS_C=""    # coloured COMPACT key-hints (used when full won't fit)
CSP_CHROME_KEYS_C_W=0   # display width of the PLAIN compact key-hints
CSP_CHROME_LEGEND=""    # coloured, width-fitted marker legend (+ first-run hint)
CSP_CHROME_HAVE_STATE="" # CSP_HAVE_STATE the legend was built for (cache key)

# csp_build_chrome COLS ROWS — (re)build the cached chrome for a terminal size.
# Called from csp_draw only when the size changed, so the forky width/rule work
# here happens at most once per resize instead of once per keypress.
csp_build_chrome() {
  local cols="$1" rows="$2" header keys_plain
  CSP_CHROME_COLS="$cols"
  CSP_CHROME_ROWS="$rows"
  CSP_CHROME_HAVE_STATE="$CSP_HAVE_STATE"   # legend's first-run hint depends on this

  # Inner content width = terminal minus the two corner columns, capped at 96 for
  # readability. It must NEVER exceed cols-2, or the frame's rules (CSP_INNER+2
  # wide) would be wider than the terminal and wrap/scroll on every repaint —
  # which is exactly what the old `floor to 40` did on a <42-column terminal. On
  # a narrow terminal CSP_INNER is just cols-2 and the content truncates to fit;
  # the frame fits the screen for any cols >= 3 (the practical floor — the two
  # corner glyphs plus one rule column need three columns; a 1–2 column terminal
  # can't hold even a bare border and is not a usable TUI size). Floor CSP_INNER
  # at 1 so the arithmetic stays sane at absurd sizes rather than going negative.
  CSP_INNER=$(( cols - 2 ))
  [ "$CSP_INNER" -gt 96 ] && CSP_INNER=96
  [ "$CSP_INNER" -lt 1 ] && CSP_INNER=1
  CSP_CHROME_VISIBLE="$rows"

  # Rules (top carries the title). csp_rule appends to CSP_BUF, so capture via a
  # temporary swap instead of duplicating its logic.
  local save="$CSP_BUF"
  CSP_BUF=""; csp_rule top "Claude Session Picker"; CSP_CHROME_TOP="${CSP_BUF%$'\033[K\n'}"
  CSP_BUF=""; csp_rule mid;                          CSP_CHROME_MID="${CSP_BUF%$'\033[K\n'}"
  CSP_BUF=""; csp_rule bot;                          CSP_CHROME_BOT="${CSP_BUF%$'\033[K\n'}"
  CSP_BUF="$save"

  # Column-heading row (fit to width, dimmed).
  header=$(csp_format_line "●" "Title" "Project" "Last active" 0)
  csp_fit_field "$header" "$CSP_INNER"
  local h="$__csp_fit"; while [ "${h% }" != "$h" ]; do h="${h% }"; done
  CSP_CHROME_HEADER="${CSP_C_HEADER} ${h}${CSP_C_RESET}"

  # Status-bar key hints (coloured) + the plain text's width for spacing math.
  # We cache TWO variants — full and compact — and csp_draw picks whichever fits
  # once the dynamic right-hand info (attention badge + position) is accounted
  # for. This is what keeps the bar from wrapping the frame on a narrow terminal
  # or when the badge is present (the full hints alone are ~66 columns).
  keys_plain="j/k move   / filter   Enter open   n new   d del   t tmux   q quit"
  CSP_CHROME_KEYS_W=$(csp_display_width "$keys_plain")
  CSP_CHROME_KEYS="${CSP_C_KEY}j/k${CSP_C_RESET}${CSP_C_DIM} move   ${CSP_C_KEY}/${CSP_C_RESET}${CSP_C_DIM} filter   ${CSP_C_KEY}Enter${CSP_C_RESET}${CSP_C_DIM} open   ${CSP_C_KEY}n${CSP_C_RESET}${CSP_C_DIM} new   ${CSP_C_KEY}d${CSP_C_RESET}${CSP_C_DIM} del   ${CSP_C_KEY}t${CSP_C_RESET}${CSP_C_DIM} tmux   ${CSP_C_KEY}q${CSP_C_RESET}${CSP_C_DIM} quit${CSP_C_RESET}"
  # Compact fallback: the essentials only (~30 columns).
  local keys_c_plain="j/k · / filter · Enter · q quit"
  CSP_CHROME_KEYS_C_W=$(csp_display_width "$keys_c_plain")
  CSP_CHROME_KEYS_C="${CSP_C_KEY}j/k${CSP_C_RESET}${CSP_C_DIM} · ${CSP_C_KEY}/${CSP_C_RESET}${CSP_C_DIM} filter · ${CSP_C_KEY}Enter${CSP_C_RESET}${CSP_C_DIM} · ${CSP_C_KEY}q${CSP_C_RESET}${CSP_C_DIM} quit${CSP_C_RESET}"

  # Marker legend (+ optional first-run hint), width-FITTED here so it can never
  # overflow the frame and wrap — which on a narrow/80-col terminal would push
  # the frame taller than csp_visible_rows budgeted and make the bottom border
  # jitter on every repaint. We build the plain text, append the "live status
  # off" hint ONLY if it still fits CSP_INNER, then colour just the two marker
  # glyphs at their known positions (never a content-wide search). The base
  # legend "● working   ✳ needs you" is 24 columns; on a normal frame it always
  # fits, but a very narrow terminal (CSP_INNER < 24) can't hold it — there we
  # fall back to a width-FITTED plain legend (no fixed-offset glyph colouring,
  # since truncation would move the glyphs) so it still never overflows.
  local base_plain hint_plain leg_plain leg
  base_plain="${CSP_MARKER_WORKING} working   ${CSP_MARKER_ATTENTION} needs you"
  hint_plain="   ·  live status off — run --doctor"
  if [ "$(csp_display_width "$base_plain")" -gt "$CSP_INNER" ]; then
    # Too narrow for the coloured base legend: fit the plain text and stop.
    csp_fit_field "$base_plain" "$CSP_INNER"
    local s="$__csp_fit"; while [ "${s% }" != "$s" ]; do s="${s% }"; done
    CSP_CHROME_LEGEND="${CSP_C_DIM} ${s}${CSP_C_RESET}"
  else
    leg_plain="$base_plain"
    if [ "$CSP_HAVE_STATE" != "1" ] \
       && [ "$(csp_display_width "$base_plain$hint_plain")" -le "$CSP_INNER" ]; then
      leg_plain="$base_plain$hint_plain"
    fi
    # Colour the ● (position 0) and the ✳ (position after "● working   " = 12).
    leg="${CSP_C_LIVE}${CSP_MARKER_WORKING}${CSP_C_RESET}${CSP_C_DIM}${leg_plain:1:11}${CSP_C_ATTN}${CSP_MARKER_ATTENTION}${CSP_C_RESET}${CSP_C_DIM}${leg_plain:13}${CSP_C_RESET}"
    CSP_CHROME_LEGEND=" ${leg}"
  fi

  # The selected-row line is padded to CSP_INNER, so rebuild every row's cached
  # display lines whenever the width (and thus CSP_INNER) changed. Bound the loop
  # by the number of rows actually present (${#csp_rows[@]}), not csp_count: they
  # are normally equal, but decoupling them keeps this from reading unset entries
  # under `set -u` should the two ever diverge. The `:-` on the row is a further
  # belt-and-suspenders.
  local j=0 nrows="${#csp_rows[@]}"
  while [ "$j" -lt "$nrows" ]; do
    csp_precompute_lines "$j" "${csp_rows[$j]:-}"
    j=$(( j + 1 ))
  done
}

# csp_draw SELECTED — build the whole menu into CSP_BUF and paint it in ONE
# write, so moving the cursor never flickers. Layout: title rule, mode line,
# rule, column headings, session rows (selected one highlighted), rule, and a
# status bar. Only the rows that fit are drawn; the selection is kept in view.
csp_draw() {
  local selected="$1" i visible start last
  local mode_line cols

  # Fit the layout to the terminal. Terminal size rarely changes between key
  # presses, so we only recompute the size-dependent CHROME (rules, header,
  # visible-row count, status-bar spacing) when the width/height actually
  # changes. Every other keypress reuses the cached chrome — that's what keeps
  # cursor movement instant instead of re-forking a dozen helpers per draw.
  cols=$(csp_term_cols)
  local rows_now; rows_now=$(csp_visible_rows)
  # Rebuild the cached chrome when the width/height OR the hook-state flag changed
  # (the latter only flips the legend's first-run hint, but must not go stale).
  if [ "$cols" != "$CSP_CHROME_COLS" ] || [ "$rows_now" != "$CSP_CHROME_ROWS" ] \
     || [ "$CSP_HAVE_STATE" != "$CSP_CHROME_HAVE_STATE" ]; then
    csp_build_chrome "$cols" "$rows_now"
  fi

  CSP_BUF=""                       # start a fresh frame in the buffer
  csp_buf_line "$CSP_CHROME_TOP"   # cached top rule (with title)

  if [ "$CSP_ACTIVE_BACKEND" = "tmux" ]; then
    # The picker is resident in window 0; sessions open as new windows and keep
    # running. The bottom status bar lists them and spells out the switch keys.
    mode_line="mode: tmux · Enter opens a session in its own window · switch with Ctrl-b n/p, menu = Ctrl-b 0  (t: off)"
  else
    mode_line="mode: hub · one session at a time, quit to return here"
    if csp_tmux_available; then
      mode_line="$mode_line  (press t: enable tmux for concurrency)"
    elif [ "$CSP_BACKEND_CHOICE" = "tmux" ]; then
      # A remembered/forced tmux choice couldn't be honoured on this box.
      mode_line="$mode_line  — tmux not installed here, using hub"
    fi
  fi
  # A one-shot startup notice (e.g. a bogus CSP_BACKEND) rides the mode line for
  # the first frame, then clears so it doesn't nag.
  if [ -n "$CSP_STARTUP_NOTICE" ]; then
    mode_line="$mode_line   [$CSP_STARTUP_NOTICE]"
    CSP_STARTUP_NOTICE=""
  fi
  csp_buf_row "$mode_line" 0 "$CSP_C_DIM"

  # Marker legend (+ first-run hint), width-fitted and cached in csp_build_chrome
  # so it can never overflow and wrap the frame. It spells out what ●/✳ mean, and
  # — only until the optional hooks are wired — nudges toward --doctor.
  csp_buf_line "$CSP_CHROME_LEGEND"
  csp_buf_line "$CSP_CHROME_MID"

  if [ "$csp_count" -eq 0 ]; then
    csp_buf_row "No Claude sessions found under $CSP_CLAUDE_DIR/projects"
    csp_buf_row "Start one with:  claude    then reopen this picker."
    csp_buf_line "$CSP_CHROME_BOT"
    # Paint: home the cursor, write the buffer, clear anything below.
    printf '\033[H%s\033[J' "$CSP_BUF"
    return
  fi

  csp_buf_line "$CSP_CHROME_HEADER"   # cached column-heading row

  # A filter that matches nothing: say so plainly instead of an empty pane, and
  # still draw the status bar (which shows the query and how to clear it).
  if [ "$csp_view_count" -eq 0 ]; then
    csp_buf_row "No sessions match \"$CSP_FILTER\" — press / then Enter to clear."
  fi

  # We navigate/draw in VIEW positions (0..csp_view_count-1). Each visible row
  # maps to a MODEL index via csp_view, and the precomputed line arrays are
  # indexed by MODEL position — so we look those up through the mapping.
  visible="$CSP_CHROME_VISIBLE"
  start=$(csp_window_start "$selected" "$csp_view_count" "$visible")
  last=$((start + visible))
  [ "$last" -gt "$csp_view_count" ] && last="$csp_view_count"

  # Emit the precomputed, display-ready lines directly (no per-row width work or
  # forks — that's the hot path). Each row was rendered once at load into two
  # ready forms: csp_line_normal (marker tinted) and csp_line_selected (reverse
  # video, cursor pointer). The `:-` defaults are belt-and-suspenders: should a
  # gap ever occur, we draw a blank row instead of aborting under `set -u`.
  i="$start"
  while [ "$i" -lt "$last" ]; do
    local mi="${csp_view[$i]:-0}"          # view position → model index
    if [ "$i" -eq "$selected" ]; then
      csp_buf_line "${csp_line_selected[$mi]:-}"
    else
      csp_buf_line "${csp_line_normal[$mi]:-}"
    fi
    i=$((i + 1))
  done

  csp_buf_line "$CSP_CHROME_MID"
  # Status bar: key hints on the left + a dynamic right-hand block (attention
  # badge, then the position/filter indicator). The RIGHT block has priority —
  # it carries the live count and the active filter — so we size it first, then
  # give the LEFT hints whatever room remains: the full hints if they fit, else
  # the compact set, else nothing. All spacing uses DISPLAY WIDTH (columns), the
  # same measure as the cached key widths — a character count (${#}) would
  # under-measure a CJK filter query (1 char = 2 columns) and wrap the frame.
  #
  # Position counts within the VISIBLE view; with a filter active we show the
  # (column-bounded) query and the visible/total split so the narrowing is clear.
  local pos_plain pos_col
  if [ -n "$CSP_FILTER" ]; then
    local shown_filter
    shown_filter=$(csp_truncate_display "$CSP_FILTER" 20)   # bound wide/long queries
    pos_plain="/$shown_filter  $((selected + 1))/${csp_view_count} of ${csp_count}"
  else
    pos_plain="$((selected + 1))/${csp_count}"
  fi
  pos_col=$(csp_display_width "$pos_plain")
  # Attention badge ("N✳ *:jump") — the coloured form is separate from the plain
  # form used for width. Pure ASCII+one 1-column glyph, so its width is known.
  local badge="" badge_col=0
  if [ "$CSP_ATTENTION_COUNT" -gt 0 ]; then
    badge_col=$(csp_display_width "${CSP_ATTENTION_COUNT}${CSP_MARKER_ATTENTION} *:jump   ")
    badge="${CSP_C_ATTN}${CSP_ATTENTION_COUNT}${CSP_MARKER_ATTENTION}${CSP_C_RESET}${CSP_C_DIM} ${CSP_C_KEY}*${CSP_C_RESET}${CSP_C_DIM}:jump   "
  fi
  # First bound the RIGHT block itself against the frame — it has priority, but
  # it must still fit. On a very narrow terminal (e.g. 40 cols) the badge plus a
  # bounded filter position can alone exceed CSP_INNER; if we only sized the LEFT
  # hints against it, the line would still overflow and wrap. So we shrink the
  # right block in priority order until it fits: drop the badge first (the
  # position + filter carry more information), then, if the position alone is
  # still too wide, hard-truncate it. We truncate to CSP_INNER-1, not CSP_INNER:
  # even with no key hints the line is emitted as one leading pad space + the
  # position, and the pad is clamped to a minimum of 1, so the position must
  # leave room for that one column or the line would be CSP_INNER+1 wide.
  local right_col=$(( badge_col + pos_col ))
  if [ "$right_col" -gt "$CSP_INNER" ]; then
    badge=""; badge_col=0
    right_col="$pos_col"
    if [ "$right_col" -gt "$(( CSP_INNER - 1 ))" ]; then
      pos_plain=$(csp_truncate_display "$pos_plain" "$(( CSP_INNER - 1 ))")
      pos_col=$(csp_display_width "$pos_plain")
      right_col="$pos_col"
    fi
  fi
  # Choose the widest key-hints variant that still leaves the right block room
  # (with at least one space of separation). If neither fits, drop the hints.
  local keys="" keys_col=0
  if [ "$(( CSP_CHROME_KEYS_W + 1 + right_col ))" -le "$CSP_INNER" ]; then
    keys="$CSP_CHROME_KEYS"; keys_col="$CSP_CHROME_KEYS_W"
  elif [ "$(( CSP_CHROME_KEYS_C_W + 1 + right_col ))" -le "$CSP_INNER" ]; then
    keys="$CSP_CHROME_KEYS_C"; keys_col="$CSP_CHROME_KEYS_C_W"
  fi
  local gap=$(( CSP_INNER - keys_col - right_col ))
  # Floor the gap to a 1-column SEPARATOR only when key hints are actually
  # present — a separator between the (left) hints and the (right) block. With no
  # hints there is nothing to separate, so a forced pad of 1 would push a
  # right-block that exactly fills CSP_INNER one column past it (CSP_INNER+1). So:
  # hints present → min gap 1; no hints → min gap 0.
  if [ -n "$keys" ]; then
    [ "$gap" -lt 1 ] && gap=1
  else
    [ "$gap" -lt 0 ] && gap=0
  fi
  local pad="" k=0
  while [ "$k" -lt "$gap" ]; do pad="$pad "; k=$(( k + 1 )); done
  csp_buf_line " ${keys}${pad}${badge}${CSP_C_DIM}${pos_plain}${CSP_C_RESET}"
  csp_buf_line "$CSP_CHROME_BOT"

  # Paint the whole frame in one write: home the cursor (no full clear → no
  # flicker), write the buffer (each line self-clears to EOL), then clear any
  # leftover lines below the frame.
  printf '\033[H%s\033[J' "$CSP_BUF"
}

# csp_open ID PROJECT LABEL — open a session through the active backend.
#
# The two backends need opposite terminal handling, and getting this wrong is
# what would wedge the terminal, so it is centralised here:
#
#   • hub  — we must give the terminal back to Claude, run it, and then take the
#     terminal BACK when Claude exits so the menu can redraw. So: restore the
#     terminal, run the session (which blocks until it exits), then re-enter raw
#     mode and reload the list. Control naturally returns to the main loop.
#
#   • tmux — the picker is resident in window 0 of the holding session. Opening
#     a session creates a NEW window running it and switches there; the picker
#     KEEPS RUNNING in window 0 (we do NOT exit). You come back with Ctrl-b 0 and
#     switch between sessions with Ctrl-b n/p/w — all stay alive in the
#     background. We briefly leave/re-enter raw mode around the tmux calls so the
#     terminal is clean. If tmux FAILS, we fall back to hub for this one launch.
csp_open() {
  local id="$1" project="$2" label="$3"
  if [ "$CSP_ACTIVE_BACKEND" = "tmux" ]; then
    if csp_tmux_open "$id" "$project" "$label"; then
      # Success: tmux switched us to the new window; the picker stays in window
      # 0. When you Ctrl-b 0 back, the loop is still running and will redraw.
      return 0
    fi
    # tmux launch failed — tell the user and fall back to running it here.
    csp_restore_terminal
    printf 'tmux could not open the session; running it here instead.\n' >&2
    csp_hub_open "$id" "$project"
    csp_enter_raw_mode
    csp_load_sessions
    return 0
  fi
  # hub mode
  csp_restore_terminal
  csp_hub_open "$id" "$project"
  csp_enter_raw_mode
  csp_load_sessions
}

# csp_prompt_line VARNAME PROMPT — read ONE line of input into VARNAME, from a
# cooked-mode terminal so the user gets normal echo, Backspace, paste, and
# correct multi-byte (CJK) entry — none of which raw single-byte reads give us.
# This is the single home for the raw→cooked→raw transition every line prompt
# needs: drop to the saved (cooked) settings + show the cursor, read the line,
# then re-enter raw mode. Both the delete confirmation and the filter query use
# it, so they can never drift apart in how they toggle terminal state.
csp_prompt_line() {
  local __var="$1" prompt="$2"
  [ -n "$csp_saved_stty" ] && stty "$csp_saved_stty" 2>/dev/null
  printf '\033[?25h'
  csp_tty_print "$prompt"
  csp_tty_readline "$__var"
  csp_enter_raw_mode
}

# csp_pause_notice MSG — show MSG, wait for the user to press Enter, then carry
# on. The single home for the "something needs your attention; acknowledge and
# continue" pattern (a session is still running, a delete failed, tmux isn't
# installed): fully restore the terminal so MSG is readable, show it, wait for
# one line, then re-enter raw mode. Centralised so every notice toggles terminal
# state identically. MSG should already contain any leading newline it wants.
csp_pause_notice() {
  local _
  csp_restore_terminal
  csp_tty_print "$1"
  csp_tty_readline _
  csp_enter_raw_mode
}

# csp_confirm PROMPT — ask a yes/no question and return 0 only for an explicit
# "y". Uses the shared cooked-mode line prompt. Used to guard the destructive
# delete action.
csp_confirm() {
  local answer
  csp_prompt_line answer "$(printf '\n%s' "$1")"
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

# csp_filter_prompt — read a filter query on one cooked-mode line, then apply it.
#
# WHY A LINE PROMPT (not per-keystroke raw reading): reading the query a byte at
# a time in raw mode is fragile — it would have to reassemble multi-byte (CJK)
# input and reimplement Backspace/paste by hand. The shared csp_prompt_line gives
# us correct UTF-8, line editing, and paste for free, and it is trivially
# testable. The whole list is in memory, so re-filtering on Enter is instant even
# for a big store.
#
# Empty input CLEARS the filter (shows everything again). The query is applied by
# rebuilding csp_view; the caller resets the selection to the top.
csp_filter_prompt() {
  local query
  csp_prompt_line query "$(printf '\nFilter (substring of title or project; empty = show all):\n/ ')"
  CSP_FILTER="$query"
  csp_rebuild_view
  csp_retally_attention   # the visible set changed → refresh the urgency count
}

# How recently a transcript must have been written to count as "a live Claude is
# using it" for the delete guard's fail-closed backstop (see below). Claude Code
# appends to the .jsonl on every turn/tool step, so a session in active use has a
# very fresh mtime; a crashed/abandoned one goes stale within seconds. 60s is a
# comfortable margin over normal think/stream gaps without keeping a truly dead
# session undeletable for long.
CSP_LIVE_MTIME_WINDOW=60

# csp_delete_would_hit_live ID [FILE] — return 0 (true) if deleting session ID
# right now would clobber a session that is actively in use. It FAILS CLOSED:
# when we cannot positively prove a session is dead, we treat it as live and
# refuse, because deleting a live transcript is unrecoverable while refusing a
# dead one is merely a minor annoyance. Signals, any of which blocks:
#   • a live `claude --resume <id>` process (csp_running_session_ids);
#   • an OPEN tmux window tagged @csp_sid=<id> on OUR server (a bare `n` session
#     the process scan can't see);
#   • a live RESIDENCY record — the hook saw this session running in a tmux pane
#     we don't own (a legacy server that survived an upgrade, or the user's own
#     tmux) and recorded (socket,pane) in our state dir; a read-only probe says
#     that pane is still open. Idle-INDEPENDENT and ownership-INDEPENDENT, so it
#     closes the gap where an untagged bare session in an unrecognised server went
#     deletable once the mtime window elapsed;
#   • a hook state of "working"; and
#   • THE FAIL-CLOSED BACKSTOP — FILE's mtime is within CSP_LIVE_MTIME_WINDOW.
#     This is ownership- and topology-INDEPENDENT: it does not rely on the tmux
#     server being recognised as ours (which the earlier signals do), so it still
#     protects a live bare session even when the holding server is a legacy one
#     whose menu window crashed, or is otherwise unrecognisable. A live Claude is
#     writing that file continuously; a crashed one's mtime is stale, so it stays
#     deletable. If FILE exists but its mtime can't be read (stat coerces to 0),
#     we ALSO block — an existing-but-unreadable file is exactly the "can't prove
#     it's dead" case, so it fails closed rather than open.
# IDLE + HOOKS: a bare `n` session idle at a prompt isn't writing (stale mtime).
# With the hooks installed it is still protected regardless of idle time, in EVERY
# server topology: inside our own server by the @csp_sid window tag (signal 2);
# inside a server we don't own (legacy-after-upgrade, or the user's own tmux) by
# the residency signal above. Only with hooks NOT installed does an idle bare
# session fall through to the mtime backstop alone and become deletable after
# CSP_LIVE_MTIME_WINDOW — the README safety note says so and --doctor warns when
# hooks aren't wired.
# We still don't block on a lone stale "waiting" state (crashed/abandoned) — the
# mtime backstop, not the state, is what distinguishes live from dead now.
# Evaluated at call time (fresh scans + fresh stat).
csp_delete_would_hit_live() {
  local id="$1" file="${2:-}" state now mtime
  csp_is_live "$id" "$(csp_running_session_ids)" && return 0
  [ -n "$(csp_tmux_window_for_sid "$id")" ] && return 0
  # Ownership-independent residency: a hooked session living in a tmux pane we
  # don't own (legacy server after an upgrade, or the user's own tmux) is still
  # live. The hook recorded (socket,pane); block while that pane is open. This is
  # idle-independent, unlike the mtime backstop below.
  csp_residency_is_live "$id" && return 0
  state=$(csp_read_state "$id")
  [ "$state" = "working" ] && return 0
  # Fail-closed mtime backstop: block if the transcript was written to within the
  # window, OR if it exists but its mtime is unreadable (0 → can't prove dead).
  if [ -n "$file" ] && [ -f "$file" ]; then
    now=$(csp_now_epoch)
    mtime=$(csp_file_mtime "$file")
    [ "$mtime" -eq 0 ] && return 0
    [ "$(( now - mtime ))" -lt "$CSP_LIVE_MTIME_WINDOW" ] && return 0
  fi
  return 1
}

# csp_delete_busy_notice ID TITLE — the message shown when a delete is refused
# because the session looks busy. It words itself by WHICH signal fired, so it's
# never misleading: a real live `claude --resume` process says "running right
# now"; a hook-"working" state with no live process (a bare `n` session, or a
# crash the reconciler shows as ✳) says "marked busy" instead and points at the
# recovery — open it once (Enter clears the stale flag) or quit that Claude.
csp_delete_busy_notice() {
  local id="$1" title="$2"
  if csp_is_live "$id" "$(csp_running_session_ids)"; then
    printf '\n"%s" is running right now — quit that Claude first, then delete.\nPress Enter to continue…' "$title"
  else
    printf '\n"%s" is still marked busy (a Claude has it open, or a crashed one left the flag set).\nQuit that Claude, or open it once (Enter) to clear a stale flag, then delete.\nPress Enter to continue…' "$title"
  fi
}

# csp_action_delete INDEX — confirm, then permanently delete the selected
# session's transcript file, then reload the list. Deleting throws away that
# conversation's history, so we always confirm first and we never touch a live
# session (one Claude is currently running) — killing its file mid-run would be
# surprising; the user should quit that Claude first.
csp_action_delete() {
  local idx="$1" title file id
  [ "$csp_count" -gt 0 ] || return 0
  title="${csp_titles[$idx]}"
  file="${csp_files[$idx]}"
  id="${csp_ids[$idx]}"

  # Liveness check, re-evaluated NOW rather than trusting the cached csp_lives
  # from the last load: a session could have been resumed (by us in tmux, or by
  # another terminal) since then, and deleting a live session's transcript
  # mid-run is exactly what we promise not to do. csp_delete_would_hit_live does
  # the fresh check via its signals — a live `claude --resume <id>` process, an
  # open tmux window tagged with this id, the hook "working" state, or the
  # ownership-independent transcript-mtime backstop — and fails closed. We pass
  # the transcript path so the mtime backstop can run, and re-run it after the
  # confirmation too.
  if csp_delete_would_hit_live "$id" "$file"; then
    csp_pause_notice "$(csp_delete_busy_notice "$id" "$title")"
    return 0
  fi

  if csp_confirm "Delete session \"$title\"? This erases its history. [y/N] "; then
    # Re-check liveness AFTER the confirmation prompt, immediately before we
    # unlink: the user may have taken seconds to answer, and the session could
    # have been resumed in another terminal in that window. This is the tight
    # check-then-act pair; a resume that races between this check and the unlink
    # itself is a residual we accept (fully closing it needs a per-session lock
    # shared with resume — noted as a follow-up). Abort with a notice if now live.
    if csp_delete_would_hit_live "$id" "$file"; then
      csp_pause_notice "$(printf '\n"%s" was just resumed — not deleting a running session.\nQuit that Claude first, then delete. Press Enter to continue…' "$title")"
      csp_load_sessions
      return 0
    fi
    if csp_delete_session_file "$file"; then
      # Forget any recorded ●/✳ state and residency for the now-deleted session.
      csp_clear_state "$(csp_session_id_from_path "$file")"
      csp_clear_residency "$(csp_session_id_from_path "$file")"
    else
      # Deleting is a "doing" action, so a failure is surfaced, not swallowed:
      # a permission error, read-only filesystem, or a lost race must not look
      # like success (the user might believe sensitive history is gone when it
      # is still on disk). Tell them, then continue.
      csp_pause_notice "$(printf '\nCould not delete "%s".\nIt may be protected, on a read-only disk, or already gone — it is still on disk if it existed.\nPress Enter to continue…' "$title")"
    fi
    csp_load_sessions
  fi
}

# csp_toggle_backend — flip between hub and tmux from inside the menu (the 't'
# key). tmux mode is what lets you keep several sessions running and jump
# between them with tmux's own keys (Ctrl-b n/p/w); hub runs one at a time and
# returns here on exit. The choice is saved so it sticks next time. If tmux
# isn't installed we can't offer tmux mode, so we say so instead of pretending.
csp_toggle_backend() {
  if [ "$CSP_ACTIVE_BACKEND" = "tmux" ]; then
    CSP_ACTIVE_BACKEND="hub"
  else
    if ! csp_tmux_available; then
      csp_pause_notice "$(printf '\ntmux mode needs the tmux command, which is not installed.\nInstall it (e.g. brew install tmux) then press t again. Enter to continue…')"
      return 0
    fi
    CSP_ACTIVE_BACKEND="tmux"
    # If we're not already inside our tmux, relaunch into the holding session so
    # the picker becomes window 0. csp_tmux_enter normally execs and never
    # returns; if it DOES return, it failed — so we must NOT have saved a tmux
    # preference (that would make every future plain launch re-enter and fail
    # too), and we must put the terminal back into raw mode and carry on in hub.
    if ! csp_inside_tmux; then
      csp_restore_terminal
      csp_tmux_enter "$CSP_ROOT/bin/claude-session-picker"
      # Reached only if entering tmux failed: stay in hub for this run.
      CSP_ACTIVE_BACKEND="hub"
      csp_enter_raw_mode
      return 0
    fi
    # Already inside our tmux — safe to remember the choice.
    csp_save_backend_pref "$CSP_ACTIVE_BACKEND"
    return 0
  fi
  csp_save_backend_pref "$CSP_ACTIVE_BACKEND"
}

# --- Diagnostics -------------------------------------------------------------
# csp_doctor — a read-only preflight check. When markers never appear, titles
# show "(untitled)", or tmux mode won't start, this tells you WHY in one screen:
# each dependency and path the tool relies on, marked OK or WARN. It touches
# nothing (no files written, no terminal raw mode, no session launched), so it is
# always safe to run and to pipe. It never exits non-zero for a mere WARN — a
# warning is informational, not a failure — but returns non-zero only if `claude`
# itself is missing, the one thing that stops the tool working at all.
csp_doctor() {
  local ok=0 problem=0 parser hooks_file
  # A small helper closure via positional printing; colour reuses the palette.
  # We print "  OK  " in green and "  WARN" in yellow when colour is on.
  local g="$CSP_C_LIVE" y="$CSP_C_ATTN" d="$CSP_C_DIM" r="$CSP_C_RESET"
  csp_doctor_ok()   { printf '  %sOK%s   %s\n'   "$g" "$r" "$1"; }
  csp_doctor_warn() { printf '  %sWARN%s %s\n'   "$y" "$r" "$1"; }

  printf '%sclaude-session-picker %s — doctor%s\n\n' "$CSP_C_TITLE" "$CSP_VERSION" "$r"

  # 1. claude on PATH — the only hard requirement.
  if command -v claude >/dev/null 2>&1; then
    csp_doctor_ok "claude command found: $(command -v claude)"
  else
    csp_doctor_warn "claude command NOT on PATH — the picker can't resume sessions."
    printf '       Install Claude Code: https://claude.com/claude-code\n'
    problem=1
  fi

  # 2. Which JSON parser will be used to read session titles (jq > python3 > awk).
  if command -v jq >/dev/null 2>&1; then
    parser="jq ($(command -v jq))"
  elif command -v python3 >/dev/null 2>&1; then
    parser="python3 ($(command -v python3))"
  else
    parser="built-in awk reader (no jq/python3 — still works)"
  fi
  csp_doctor_ok "JSON parser: $parser"

  # 3. Claude's session store (where sessions are read from).
  if [ -d "$CSP_CLAUDE_DIR/projects" ]; then
    csp_doctor_ok "session store: $CSP_CLAUDE_DIR/projects"
  else
    csp_doctor_warn "no session store at $CSP_CLAUDE_DIR/projects — no sessions to list yet."
  fi

  # 4. Hooks wired for the ●/✳ markers. We look for our hook path referenced in
  # Claude's settings.json; absence is fine (markers fall back to live/blank).
  hooks_file="$CSP_CLAUDE_DIR/settings.json"
  if [ -f "$hooks_file" ] && grep -q 'csp-hook\.sh' "$hooks_file" 2>/dev/null; then
    csp_doctor_ok "status hooks wired in $hooks_file (● working / ✳ needs-you enabled)"
  else
    csp_doctor_warn "status hooks not detected in $hooks_file"
    printf '       ● shows a running session; ✳ (needs-you) needs the hooks — see\n'
    printf '       README "Status markers". Without them the picker still works.\n'
  fi
  # Report where hook state is recorded, and whether anything has been written.
  if [ -d "$CSP_STATE_DIR" ]; then
    csp_doctor_ok "state dir: $CSP_STATE_DIR"
  else
    csp_doctor_warn "state dir not created yet: $CSP_STATE_DIR (hooks have not run)"
  fi

  # 5. tmux — optional; only needed for concurrent windows.
  if csp_tmux_available; then
    csp_doctor_ok "tmux found: $(command -v tmux) (concurrent mode available via 't')"
  else
    csp_doctor_warn "tmux not installed — hub mode only (that's fine for most people)."
  fi

  # 6. Resolved paths and current backend choice, for context.
  printf '\n%sconfig%s\n' "$d" "$r"
  printf '  backend preference file: %s\n' "$CSP_PREF_FILE"
  printf '  resolved backend:        %s\n' "$CSP_ACTIVE_BACKEND"

  printf '\n'
  if [ "$problem" = "1" ]; then
    printf '%sOne or more problems above will stop the picker working.%s\n' "$y" "$r"
    return 1
  fi
  printf 'All essentials present.\n'
  return "$ok"
}

# --- Main loop ---------------------------------------------------------------
csp_main() {
  # Handle informational flags before anything else (no terminal setup, no tmux
  # re-exec) so `--version`/`--help` are cheap and safe to pipe/grep.
  case "${1:-}" in
    -V|--version)
      printf 'claude-session-picker %s\n' "$CSP_VERSION"
      exit 0 ;;
    -h|--help)
      printf 'claude-session-picker %s — a menu to list and resume Claude Code sessions.\n\n' "$CSP_VERSION"
      printf 'Usage: claude-session-picker [-V|--version] [-h|--help] [--doctor] [--list]\n\n'
      printf 'Run with no arguments to open the menu. Keys: j/k move, / filter,\n'
      printf '* jump to next needs-you, Enter open, n new, d delete, t hub/tmux, R reload, q quit.\n'
      printf 'Markers: %s working, %s stopped/needs you (needs hooks — see README\n' "●" "✳"
      printf '"Status markers"). A session started with n shows no %s until hooks are set up.\n\n' "●"
      printf '  --doctor   check dependencies, paths and hooks, then exit (read-only)\n'
      printf '  --list     print all sessions as TSV (id, title, project, age) and exit\n\n'
      printf 'Env: CSP_BACKEND=hub|tmux. Full docs: README.md and docs/MANUAL.md.\n'
      exit 0 ;;
    --doctor)
      csp_doctor
      exit $? ;;
    --list)
      # Non-interactive: print every session as tab-separated
      # "id<TAB>title<TAB>project<TAB>age" and exit. No raw mode, no launch — so
      # it composes with other tools, e.g.  claude-session-picker --list | fzf
      # This deliberately lives OUTSIDE the picker so we never take on a fuzzy
      # finder as a dependency; the model is already assembled by csp_load_sessions.
      # As a plain filter, restore default SIGPIPE handling so a downstream
      # `| head` closing the pipe ends us quietly, not via our interactive
      # PIPE→exit-130 trap (which would print a "broken pipe" write error).
      trap - PIPE
      csp_load_sessions
      local __i=0 __tab
      __tab=$'\t'
      while [ "$__i" -lt "$csp_count" ]; do
        printf '%s%s%s%s%s%s%s\n' \
          "${csp_ids[$__i]}"       "$__tab" \
          "${csp_titles[$__i]}"    "$__tab" \
          "${csp_projects[$__i]}"  "$__tab" \
          "${csp_ages[$__i]}"
        __i=$(( __i + 1 ))
      done
      exit 0 ;;
  esac

  if ! command -v claude >/dev/null 2>&1; then
    printf 'The `claude` command was not found on your PATH.\n' >&2
    printf 'Install Claude Code first: https://claude.com/claude-code\n' >&2
    exit 1
  fi

  # tmux mode, and we're not yet inside our tmux → relaunch ourselves INSIDE the
  # holding tmux session as window 0 (see csp_tmux_enter). This is what makes
  # the picker resident: every session you open becomes another window and the
  # picker stays put in window 0 (Ctrl-b 0 to come back). csp_tmux_enter normally
  # execs tmux and never returns; the re-launched copy comes back here already
  # inside tmux and runs the menu loop below. If it RETURNS, entering tmux failed
  # — fall back to hub for this run rather than continuing in a broken state.
  if [ "$CSP_ACTIVE_BACKEND" = "tmux" ] && ! csp_inside_tmux; then
    csp_tmux_enter "$CSP_ROOT/bin/claude-session-picker"
    CSP_ACTIVE_BACKEND="hub"     # only reached if the exec failed
  fi

  local selected=0 key label

  # Load the session list BEFORE switching the terminal to raw mode. Loading
  # reads files and can take a moment on a big store; doing it first means the
  # terminal is never sitting in raw mode during that work (so nothing can leave
  # it raw if loading is interrupted), and the first frame appears fully built.
  csp_load_sessions
  csp_enter_raw_mode
  # `selected` is a VIEW position (0..csp_view_count-1), not a model index. It is
  # mapped to a model index through csp_view only where we read the model (open,
  # delete). This keeps filtering a thin layer over the unchanged model.
  local mi
  while :; do
    selected=$(csp_clamp_index "$selected" "$csp_view_count")
    csp_draw "$selected"
    key=$(csp_read_key)
    case "$key" in
      j) selected=$(csp_clamp_index "$((selected + 1))" "$csp_view_count") ;;
      k) selected=$(csp_clamp_index "$((selected - 1))" "$csp_view_count") ;;
      g) selected=0 ;;
      G) selected=$(csp_clamp_index "$((csp_view_count - 1))" "$csp_view_count") ;;
      '/') # Type-to-filter: narrow the list to sessions whose title/project
           # contains what you type. Empty input clears the filter.
         csp_filter_prompt; selected=0 ;;
      $'\n'|$'\r'|'')
         if [ "$csp_view_count" -gt 0 ]; then
           mi="${csp_view[$selected]}"        # view position → model index
           # A tmux window name can't contain much; use the short project path.
           label="${csp_projects[$mi]}"
           # Opening a session means you've now looked at it, so clear any
           # "needs attention" (✳) state for it before handing off.
           csp_clear_state "${csp_ids[$mi]}"
           csp_open "${csp_ids[$mi]}" "${csp_fullprojects[$mi]}" "$label"
         fi ;;
      n) # Start a brand-new session. In hub mode that's simply $PWD; as the
         # resident tmux menu, use the directory the client actually re-attached
         # from (window 0 keeps its original cwd), so `n` isn't stuck in the dir
         # the picker was first launched from.
         if csp_inside_tmux; then
           csp_open "new" "$(csp_tmux_launch_pwd)" "new"
         else
           csp_open "new" "$PWD" "new"
         fi ;;
      d|x) # Delete the selected session (asks to confirm first). Maps the view
           # position to a model index; the reload rebuilds the view afterwards.
         if [ "$csp_view_count" -gt 0 ]; then
           mi="${csp_view[$selected]}"
           csp_action_delete "$mi"
           # The reload rebuilt the view (now one shorter). If the cursor was on
           # the last visible row, step it up to the new last row rather than
           # letting the clamp wrap it to the top. Guard for an emptied view.
           if [ "$csp_view_count" -gt 0 ] && [ "$selected" -ge "$csp_view_count" ]; then
             selected=$(( csp_view_count - 1 ))
           fi
         fi ;;
      '*') # Jump to the next VISIBLE session that needs attention (✳), wrapping.
         selected=$(csp_next_attention "$selected" "$csp_view_count" "$(csp_markers_nl)") ;;
      t) csp_toggle_backend ;;   # switch hub <-> tmux (concurrency on/off)
      R|l) csp_load_sessions ;;
      q) csp_quit; break ;;
    esac
  done
}

# csp_quit — how leaving the menu behaves.
#   • hub: just break out of the loop; the EXIT trap restores the terminal and
#     you're back at your shell.
#   • tmux: the picker IS window 0 of the holding session. If we just exited,
#     window 0 would close and — with other sessions still open — tmux would
#     drop you onto an arbitrary neighbouring window with no menu; quit the last
#     one and tmux ends entirely. That's the "q is a footgun" problem. Instead,
#     if there are OTHER windows (sessions) still alive, we DETACH the client
#     (everything keeps running, you get your shell back, and `claude-session-picker`
#     later re-attaches to the same menu). If the menu is the only window, there's
#     nothing to strand, so we just exit normally.
#
# The decision keys off csp_inside_tmux — our PHYSICAL location — NOT the logical
# CSP_ACTIVE_BACKEND. Those differ after you press `t` to toggle back to hub
# while still sitting inside the tmux menu window: the backend says "hub" but the
# picker is still window 0 with live sessions beside it, so quitting must still
# detach (never strand the client on a bare shell / kill neighbours). Physical
# state is what determines the safe action.
csp_quit() {
  if csp_inside_tmux; then
    local wins
    wins=$(csp_tmux list-windows -t "=$CSP_TMUX_SESSION" 2>/dev/null | grep -c . || printf '0')
    if [ "$wins" -gt 1 ]; then
      csp_restore_terminal
      csp_tmux detach-client 2>/dev/null
      exit 0
    fi
  fi
}

# Run the picker only when this file is executed directly. When a test sources
# it (CSP_SOURCED_FOR_TEST=1) we skip main so individual functions like
# csp_read_key can be exercised in isolation without launching the whole TUI.
if [ -z "${CSP_SOURCED_FOR_TEST:-}" ]; then
  csp_main "$@"
fi
